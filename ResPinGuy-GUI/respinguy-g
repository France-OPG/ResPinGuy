#!/bin/bash
#----------------------------------------------------------------------------------------------
# ResPinGuy - lanceur de l'interface graphique
#----------------------------------------------------------------------------------------------
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin${PATH:+:$PATH}"

RPG_GUI_DIR="${RPG_GUI_DIR:-/usr/share/respinguy-gui}"

if [ "${1-}" = "--version" ] || [ "${1-}" = "-V" ]; then
    v=$(cat /usr/share/ResPinGuy-File/VERSION 2>/dev/null | head -n1)
    [ -n "$v" ] || v="0.41"
    echo "ResPinGuy $v"
    exit 0
fi

PYTHON=""
for p in python3 python; do
    command -v "$p" >/dev/null 2>&1 || continue
    if "$p" -c 'import gi; gi.require_version("Gtk", "3.0"); from gi.repository import Gtk' >/dev/null 2>&1; then
        PYTHON="$p"
        break
    fi
done

if [ -z "$PYTHON" ]; then
    msg="Python 3 + GTK3/PyGObject est manquant.\n\nInstallez python3-gi et gir1.2-gtk-3.0,\nou utilisez l'interface texte : sudo respinguy"
    if command -v zenity >/dev/null 2>&1; then
        zenity --error --title="ResPinGuy" --text="$msg" 2>/dev/null
    elif command -v yad >/dev/null 2>&1; then
        yad --error --title="ResPinGuy" --text="$msg" 2>/dev/null
    else
        printf 'ResPinGuy : %b\n' "$msg" >&2
    fi
    exit 1
fi

export PYTHONPATH="$RPG_GUI_DIR${PYTHONPATH:+:$PYTHONPATH}"
RPG_GUI_LOG="${RPG_GUI_LOG:-/tmp/respinguy-gui.log}"
if [ -t 1 ]; then
    exec "$PYTHON" -m respinguy_gui.main "$@"
fi
exec "$PYTHON" -m respinguy_gui.main "$@" >> "$RPG_GUI_LOG" 2>&1
