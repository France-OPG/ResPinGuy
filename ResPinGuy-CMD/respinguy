#!/bin/bash
if grep -qE '(^| )root=live:|(^| )rd\.live\.image' /proc/cmdline 2>/dev/null; then
    echo "Mode live : seule l'installation est disponible. Lancez : install"
    exit 1
fi
if [ "0$UID" -ne 0 ]; then
    if command -v sudo >/dev/null 2>&1; then
        exec sudo bash /usr/share/ResPinGuy-File/respinguy "$@"
    fi
    echo "Merci d'être en root pour lancer : $(basename "$0")"; exit 1
fi
exec bash /usr/share/ResPinGuy-File/respinguy "$@"
