#!/bin/bash
#######################################################################
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin${PATH:+:$PATH}"

clear

allow_only_root() {
  if [ "0$UID" -ne 0 ]; then
     echo "Merci d'être en root pour lancer l'installation."; exit 1
  fi
}
allow_only_root

for f in ./ResPinGuy-CMD/respinguy \
          ./ResPinGuy-CMD/respinguy-app-rm \
          ./ResPinGuy-CMD/respinguy-app-up \
          ./ResPinGuy-CMD/respinguy-build \
          ./ResPinGuy-CMD/respinguy-config \
          ./ResPinGuy-CMD/respinguy-app-dep \
          ./ResPinGuy-CMD/respinguy-app-dep-force-install \
          ./ResPinGuy-CMD/install \
          ./ResPinGuy-CMD/rpg-install \
          ./ResPinGuy-GUI/respinguy-g \
          ./ResPinGuy-GUI/respinguy_gui/main.py \
          ./ResPinGuy-GUI/desktop/respinguy-g.desktop \
          ./ResPinGuy-GUI/desktop/respinguy-install-g.desktop \
          ./ResPinGuy-GUI/assets/respinguy.svg; do
    if [ ! -f "$f" ]; then echo "[ERREUR] Fichier manquant : $f"; exit 1; fi
done

read -p "Appuyez sur Entrée pour lancer l'installation..."

cp ./ResPinGuy-CMD/respinguy /usr/bin/         && chmod +x /usr/bin/respinguy         && echo "... [1/10]" || exit 1
cp ./ResPinGuy-CMD/respinguy-app-rm /usr/bin/  && chmod +x /usr/bin/respinguy-app-rm  && echo "... [2/10]" || exit 1
cp ./ResPinGuy-CMD/respinguy-app-up /usr/bin/  && chmod +x /usr/bin/respinguy-app-up  && echo "... [3/10]" || exit 1
cp ./ResPinGuy-CMD/respinguy-build /usr/bin/   && chmod +x /usr/bin/respinguy-build   && echo "... [4/10]" || exit 1
cp ./ResPinGuy-CMD/respinguy-config /usr/bin/  && chmod +x /usr/bin/respinguy-config  && echo "... [5/10]" || exit 1
cp ./ResPinGuy-CMD/respinguy-app-dep /usr/bin/ && chmod +x /usr/bin/respinguy-app-dep && echo "... [6/10]" || exit 1
cp ./ResPinGuy-CMD/respinguy-app-dep-force-install /usr/bin/ && chmod +x /usr/bin/respinguy-app-dep-force-install && echo "... [7/10]" || exit 1
cp ./ResPinGuy-CMD/install /usr/local/bin/install && chmod +x /usr/local/bin/install && echo "... [8/10]" || exit 1
cp ./ResPinGuy-CMD/rpg-install /usr/bin/ && chmod +x /usr/bin/rpg-install && echo "... [9/10]" || exit 1
cp ./ResPinGuy-GUI/respinguy-g /usr/bin/ && chmod +x /usr/bin/respinguy-g && echo "... [10/10]" || exit 1
rm -f /usr/bin/respinguy-install
echo "Les commandes sont installées."

cp -r ResPinGuy-File/ /usr/share/        && echo "... [1/5]" || exit 1
cp -r ResPinGuy-File-Config/ /usr/share/ && echo "... [2/5]" || exit 1
rm -rf /usr/share/respinguy-gui
cp -r ResPinGuy-GUI/ /usr/share/respinguy-gui && echo "... [3/5]" || exit 1
mkdir -p /usr/share/applications /usr/share/icons/hicolor/scalable/apps
cp -f ResPinGuy-GUI/desktop/respinguy-g.desktop /usr/share/applications/ && \
cp -f ResPinGuy-GUI/desktop/respinguy-install-g.desktop /usr/share/applications/ && \
chmod 0644 /usr/share/applications/respinguy-g.desktop /usr/share/applications/respinguy-install-g.desktop && \
echo "... [4/5]" || exit 1
cp -f ResPinGuy-GUI/assets/respinguy.svg /usr/share/icons/hicolor/scalable/apps/respinguy.svg && \
chmod 0644 /usr/share/icons/hicolor/scalable/apps/respinguy.svg && echo "... [5/5]" || exit 1
command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database -q /usr/share/applications 2>/dev/null || true
command -v gtk-update-icon-cache >/dev/null 2>&1 && gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true
echo "Les fichiers sont installés."

clear
if [ -r /etc/os-release ]; then
    . /etc/os-release
    echo "Distribution : ${PRETTY_NAME:-${NAME:-inconnue}}"
fi
echo "Installation des dépendances (détection automatique)..."
if ! bash /usr/share/ResPinGuy-File/respinguy-app-dep-force-install; then
    echo ""
    echo "[ATTENTION] Aucun gestionnaire de paquets utilisable."
    echo "Tentative de compilation depuis les sources (LFS / distribution indépendante)..."
    bash /usr/share/ResPinGuy-File/respinguy-deps-source || true
fi

echo ""
echo "Vérification des dépendances..."
if bash /usr/share/ResPinGuy-File/respinguy-app-dep; then
    echo "---"
    echo "ResPinGuy est prêt. Lancez : respinguy"
    echo "---"
else
    echo ""
    echo "[ERREUR] Dépendances manquantes."
    echo "Corrigez-les puis relancez : sudo bash install"
    exit 1
fi
