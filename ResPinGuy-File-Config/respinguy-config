#!/bin/bash
# ResPinGuy - Fichier de configuration
# Emplacement : /usr/share/ResPinGuy-File-Config/respinguy-config
#_____________________________________________________________________________________________
#
# Ce fichier contient les valeurs par defaut.
# L'interface (commande respinguy) enregistre vos reglages dans
# respinguy-config.local, charge en priorite juste en dessous.
#
# Vous pouvez donc modifier ce fichier a la main : les valeurs de
# respinguy-config.local restent prioritaires tant qu'il existe.
#_____________________________________________________________________________________________

RPG_CONF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"
[ -n "$RPG_CONF_DIR" ] || RPG_CONF_DIR="/usr/share/ResPinGuy-File-Config"

# --- Reglages enregistres par l'interface (prioritaires) ---
if [ -f "$RPG_CONF_DIR/respinguy-config.local" ]; then
    . "$RPG_CONF_DIR/respinguy-config.local"
fi

#_____________________________________________________________________________________________
# Valeurs par defaut

# Nom de l'image ISO generee
RPGBUILDNAME=${RPGBUILDNAME:-"Respinguy-Custom"}

# Dossier de destination de l'ISO final
# Attention : ce dossier est efface avant chaque build.
RPGHOME=${RPGHOME:-/home/ResPinGuy}

#_____________________________________________________________________________________________
# Configuration du repertoire home utilisateur
# (l'interface ecrit ces variables dans respinguy-config.local)
#
# Option 1 : inclure $HOME dans l'ISO uniquement (sans persistance)
#RPGCONFIGUSER=1
#
# Option 2 : inclure $HOME dans l'ISO ET sur le systeme installe (avec persistance)
#RPGCONFIGUSERPERS=1
#
# Repertoire home a inclure :
#HOME=/home/monuser/

#_____________________________________________________________________________________________
# Detection automatique du kernel
# (l'interface peut forcer KERNEL et VMLINUZ dans respinguy-config.local)

KERNEL=${KERNEL:-$(uname -r)}

if [ -z "${VMLINUZ-}" ] || [ ! -f "$VMLINUZ" ]; then
    # Debian / Ubuntu / Linux Mint / Fedora / RHEL / CentOS / OpenSUSE
    if [ -f "/boot/vmlinuz-$KERNEL" ]; then
        VMLINUZ="/boot/vmlinuz-$KERNEL"

    # Arch Linux (kernel generique)
    elif [ -f "/boot/vmlinuz-linux" ]; then
        VMLINUZ="/boot/vmlinuz-linux"

    # Arch Linux (kernel LTS)
    elif [ -f "/boot/vmlinuz-linux-lts" ]; then
        VMLINUZ="/boot/vmlinuz-linux-lts"

    # Gentoo
    elif [ -f "/boot/kernel-$KERNEL" ]; then
        VMLINUZ="/boot/kernel-$KERNEL"

    # Fallback : recherche automatique
    else
        VMLINUZ=$(ls /boot/vmlinuz* 2>/dev/null | head -1)
        if [ -z "$VMLINUZ" ]; then
            VMLINUZ=$(ls /boot/kernel* 2>/dev/null | head -1)
        fi
    fi
fi

#_____________________________________________________________________________________________
# Variables automatiques (ne pas modifier)

# Architecture du CPU
ARCH=${ARCH:-$(uname -m)}

# Dossiers de la racine (/) a inclure dans le squashfs
# Ne pas mettre de / devant
# Ne pas inclure : proc sys tmp run dev (geres automatiquement)
ROOTDIR=${ROOTDIR:-"bin boot etc home lib lib64 opt root sbin srv usr var"}

#_____________________________________________________________________________________________
# Verifications

if [ -z "$VMLINUZ" ] || [ ! -f "$VMLINUZ" ]; then
    echo "[ERREUR] Impossible de detecter le kernel automatiquement."
    echo "         Kernels disponibles :"
    ls /boot/vmlinuz* /boot/kernel* 2>/dev/null
    echo "         Forcez VMLINUZ et KERNEL (respinguy-config ou respinguy --config)."
    exit 1
fi

if [ -n "${RPGCONFIGUSER-}" ] && [ -n "${RPGCONFIGUSERPERS-}" ]; then
    echo "[ERREUR] RPGCONFIGUSER et RPGCONFIGUSERPERS ne peuvent pas etre definis ensemble."
    exit 1
fi

if [ -z "${RPGHOME-}" ]; then
    echo "[ERREUR] RPGHOME n'est pas defini."
    exit 1
fi
