#!/bin/bash
allow_only_root() {
  if [ "0$UID" -ne 0 ]; then echo "Merci d'être en root pour lancer : $(basename $0)"; exit 1; fi
}
allow_only_root
clear
read -p "Appuyez sur Entrée pour lancer la suppression de ResPinGuy..."
rm -f /usr/bin/respinguy         && echo "... [1/10]"
rm -f /usr/bin/respinguy-app-rm  && echo "... [2/10]"
rm -f /usr/bin/respinguy-app-up  && echo "... [3/10]"
rm -f /usr/bin/respinguy-app-dep && echo "... [4/10]"
rm -f /usr/bin/respinguy-build   && echo "... [5/10]"
rm -f /usr/bin/respinguy-config  && echo "... [6/10]"
rm -f /usr/bin/respinguy-app-dep-force-install && echo "... [7/10]"
rm -f /usr/local/bin/install && echo "... [8/10]"
rm -f /usr/bin/rpg-install && echo "... [9/10]"
rm -f /usr/bin/respinguy-g && echo "... [10/10]"
rm -f /usr/bin/respinguy-install 2>/dev/null || true
echo "Les commandes sont supprimées."
rm -rf /usr/share/ResPinGuy-File/        && echo "... [1/7]"
rm -rf /usr/share/ResPinGuy-File-Config/ && echo "... [2/7]"
rm -rf /usr/share/respinguy-gui/          && echo "... [3/7]"
rm -f /usr/share/applications/respinguy-g.desktop /usr/share/applications/respinguy-install-g.desktop && echo "... [4/7]"
rm -f /usr/share/icons/hicolor/scalable/apps/respinguy.svg && echo "... [5/7]"
rm -rf /respinguy-build-dir/             && echo "... [6/7]"
rm -f /tmp/respinguy-* 2>/dev/null || true
echo "... [7/7]"
echo "Les fichiers sont supprimés."
echo "ResPinGuy n'est plus sur votre machine."
read -p "Terminé. Appuyez sur Entrée pour quitter."
clear
