#!/bin/bash
allow_only_root() {
  if [ "0$UID" -ne 0 ]; then echo "Merci d'être en root pour lancer : $(basename $0)"; exit 1; fi
}
allow_only_root
echo "Vérification des dépendances..."
ERRORS=0
check() {
  if [ ! $(type -p $1) ]; then echo "[MANQUANT] $1"; ERRORS=$((ERRORS+1)); else echo "[OK] $1"; fi
}
check git
check wget
check bash
check sh
check nano
check uname
check dracut
check xorriso
if [ "$(mksquashfs 2>&1 | grep 'Xdict-size')" = "" ]; then
  echo "[MANQUANT] mksquashfs (ou sans support xz)"; ERRORS=$((ERRORS+1))
else
  echo "[OK] mksquashfs"
fi

# Outils UEFI (optionnels : sans eux, ISO BIOS uniquement)
UEFI_MISSING=0
if ! command -v grub-mkstandalone >/dev/null 2>&1 && ! command -v grub2-mkstandalone >/dev/null 2>&1; then
  UEFI_MISSING=1
fi
GRUB_DIR_OK=0
for d in /usr/lib/grub/x86_64-efi /usr/lib/grub2/x86_64-efi /usr/lib/grub/x86_64-efi-signed; do
  if [ -d "$d" ]; then GRUB_DIR_OK=1; break; fi
done
[ $GRUB_DIR_OK -eq 1 ] || UEFI_MISSING=1
command -v mkfs.vfat >/dev/null 2>&1 || UEFI_MISSING=1
command -v mcopy >/dev/null 2>&1 || UEFI_MISSING=1
if [ $UEFI_MISSING -eq 1 ]; then
  echo "[OPTIONNEL] Outils UEFI manquants (ISO BIOS uniquement)"
  echo "            grub-mkstandalone/grub2-mkstandalone, dosfstools, mtools"
else
  echo "[OK] outils UEFI (GRUB)"
fi
echo "---"
if [ $ERRORS -eq 0 ]; then
  echo "Toutes les dépendances sont installées."; exit 0
else
  echo "$ERRORS dépendance(s) manquante(s)."
  echo "Utilisez : /usr/share/ResPinGuy-File/respinguy-app-dep-force-install"
  exit 1
fi
