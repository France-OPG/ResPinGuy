#!/bin/bash
allow_only_root() {
  if [ "0$UID" -ne 0 ]; then echo "Merci d'être en root pour lancer : $(basename $0)"; exit 1; fi
}
allow_only_root
echo "Vérification des dépendances..."
ERRORS=0
check() {
  if [ ! $(type -p $1) ]; then echo "[MANQUANT] $1"; ERRORS=$((ERRORS+1)); else echo "[OK] $1"; fi
}
check git
check wget
check bash
check sh
check nano
check uname
check dracut
if [ -n "$(type -p dracut)" ]; then
  if ! dracut --list-modules 2>/dev/null | grep -q 'dmsquash-live'; then
    echo "[MANQUANT] module dracut dmsquash-live"; ERRORS=$((ERRORS+1))
  fi
  if ! dracut --list-modules 2>/dev/null | grep -qw 'squash'; then
    echo "[MANQUANT] module dracut squash"; ERRORS=$((ERRORS+1))
  fi
fi
check xorriso
if [ "$(mksquashfs 2>&1 | grep 'Xdict-size')" = "" ]; then
  echo "[MANQUANT] mksquashfs (ou sans support xz)"; ERRORS=$((ERRORS+1))
else
  echo "[OK] mksquashfs"
fi

# Outils UEFI (optionnels : sans eux, ISO BIOS uniquement)
UEFI_MISSING=""
if ! command -v grub-mkstandalone >/dev/null 2>&1 && ! command -v grub2-mkstandalone >/dev/null 2>&1; then
  UEFI_MISSING="$UEFI_MISSING grub-mkstandalone"
fi
GRUB_DIR_OK=0
for d in /usr/lib/grub/x86_64-efi /usr/lib/grub2/x86_64-efi /usr/lib/grub/x86_64-efi-signed; do
  if [ -d "$d" ]; then GRUB_DIR_OK=1; break; fi
done
[ $GRUB_DIR_OK -eq 1 ] || UEFI_MISSING="$UEFI_MISSING modules-grub-efi"
if ! command -v mkfs.vfat >/dev/null 2>&1 && ! command -v mkfs.fat >/dev/null 2>&1; then
  UEFI_MISSING="$UEFI_MISSING mkfs.vfat"
fi
command -v mcopy >/dev/null 2>&1 || UEFI_MISSING="$UEFI_MISSING mcopy"
if [ -n "$UEFI_MISSING" ]; then
  echo "[OPTIONNEL] Outils UEFI manquants (ISO BIOS uniquement) :$UEFI_MISSING"
else
  echo "[OK] outils UEFI (GRUB)"
fi

# Outils de l'installateur live (parted, unsquashfs, mkfs.ext4)
INST_MISSING=0
for t in parted unsquashfs mkfs.ext4 blkid tar; do
  command -v "$t" >/dev/null 2>&1 || INST_MISSING=1
done
if [ $INST_MISSING -eq 1 ]; then
  echo "[OPTIONNEL] Outils installateur manquants (parted, unsquashfs, mkfs.ext4)"
else
  echo "[OK] outils installateur"
fi
echo "---"
if [ $ERRORS -eq 0 ]; then
  echo "Toutes les dépendances sont installées."; exit 0
else
  echo "$ERRORS dépendance(s) manquante(s)."
  echo "Utilisez : /usr/share/ResPinGuy-File/respinguy-app-dep-force-install"
  exit 1
fi
