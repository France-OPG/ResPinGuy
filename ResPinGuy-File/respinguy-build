#!/bin/bash
#_____________________________________________________________________________________________
# ResPinGuy - Build
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin${PATH:+:$PATH}"

# Couleurs (meme palette que l'interface)
if [ -n "${RPG_FORCE_COLOR-}" ] || [ -t 1 ]; then
    C_RESET=$'\033[0m'
    C_GREEN=$'\033[38;2;115;186;37m'
    C_AMBER=$'\033[38;2;255;181;22m'
    C_BLUE=$'\033[38;2;29;47;82m'
    C_RED=$'\033[38;2;238;0;0m'
else
    C_RESET=""; C_GREEN=""; C_AMBER=""; C_BLUE=""; C_RED=""
fi

# Barre de progression par etapes
rpg_step() {
    local pct="$1"
    local msg="$2"
    local width=30 fill empty bar
    fill=$((pct * width / 100))
    empty=$((width - fill))
    bar=$(printf '%*s' "$fill" '' | tr ' ' '#')
    bar="$bar$(printf '%*s' "$empty" '')"
    printf '%s[%s%s%s]%s %3d%%  %s%s%s\n' \
        "$C_BLUE" "$C_GREEN" "$bar" "$C_BLUE" "$C_RESET" \
        "$pct" "$C_AMBER" "$msg" "$C_RESET"
}

allow_only_root() {
  if [ "0$UID" -ne 0 ]; then
     echo "Merci d'être en root pour lancer : $(basename $0)"; exit 1
  fi
}
allow_only_root

cd /usr/share/ResPinGuy-File-Config/ || exit 1
. ./respinguy-config || exit 1

bash /usr/share/ResPinGuy-File/respinguy-app-dep
if [ $? -ne 0 ]; then echo "[ERREUR] Dépendances manquantes. Build annulé."; exit 1; fi

if [ ! "$(dracut --list-modules 2>/dev/null | grep squash)" ]; then
    echo "[ERREUR] Module dracut manquant : squash"
    echo "         Debian/Ubuntu : apt install dracut-live"
    echo "         Fedora/RHEL   : dnf install dracut-live dracut-squash"
    echo "         Arch          : pacman -S dracut"
    exit 1
fi
if [ ! "$(dracut --list-modules 2>/dev/null | grep dmsquash-live)" ]; then
    echo "[ERREUR] Module dracut manquant : dmsquash-live"
    echo "         Debian/Ubuntu : apt install dracut-live"
    echo "         Fedora/RHEL   : dnf install dracut-live"
    echo "         Arch          : pacman -S dracut"
    exit 1
fi

if [ ! -f "$VMLINUZ" ]; then
    echo "[ERREUR] Kernel introuvable : $VMLINUZ"
    ls /boot/vmlinuz* /boot/kernel* 2>/dev/null
    exit 1
fi

if [ -z "$RPGBUILDNAME" ] || [ -z "$RPGHOME" ] || [ -z "$KERNEL" ]; then
    echo "[ERREUR] Variable RPGBUILDNAME, RPGHOME ou KERNEL non définie."; exit 1
fi
if [ -n "$RPGCONFIGUSER" ] && [ -n "$RPGCONFIGUSERPERS" ]; then
    echo "[ERREUR] RPGCONFIGUSER et RPGCONFIGUSERPERS ne peuvent pas être définis ensemble."; exit 1
fi

#_____________________________________________________________________________________________
# Preparation du demarrage (BIOS + UEFI)

# Label ISO : sert au demarrage (root=live:CDLABEL=...)
ISOLABEL=$(printf '%s' "$RPGBUILDNAME" | tr '[:lower:]' '[:upper:]' | sed 's/[^A-Z0-9_]/_/g')
ISOLABEL=${ISOLABEL:0:32}
[ -n "$ISOLABEL" ] || ISOLABEL="RESPINGUY"

# Arguments communs a tous les menus de demarrage
BOOTARGS="root=live:CDLABEL=$ISOLABEL rd.live.image rd.live.dir=LiveOS rd.live.squashimg=squashfs.img rd.live.overlay.overlayfs=1 selinux=0 apparmor=0"
MASKS="systemd.mask=rpcbind.service systemd.mask=rpcbind.socket systemd.mask=nftables.service systemd.mask=keyboard-setup.service systemd.mask=systemd-networkd-wait-online.service systemd.mask=NetworkManager-wait-online.service systemd.mask=systemd-firstboot.service systemd.mask=console-setup.service"

# Detection des outils UEFI (facultatifs : repli BIOS si absents)
RPG_UEFI=0
UEFI_MISSING=""
GRUB_MKSTANDALONE=""
GRUB_EFI_DIR=""
MKFS_VFAT=""
if command -v grub-mkstandalone >/dev/null 2>&1; then
    GRUB_MKSTANDALONE="grub-mkstandalone"
elif command -v grub2-mkstandalone >/dev/null 2>&1; then
    GRUB_MKSTANDALONE="grub2-mkstandalone"
else
    UEFI_MISSING="$UEFI_MISSING grub-mkstandalone"
fi
for d in /usr/lib/grub/x86_64-efi /usr/lib/grub2/x86_64-efi /usr/lib/grub/x86_64-efi-signed; do
    if [ -d "$d" ]; then GRUB_EFI_DIR="$d"; break; fi
done
[ -n "$GRUB_EFI_DIR" ] || UEFI_MISSING="$UEFI_MISSING modules-grub-efi"
if command -v mkfs.vfat >/dev/null 2>&1; then
    MKFS_VFAT="mkfs.vfat"
elif command -v mkfs.fat >/dev/null 2>&1; then
    MKFS_VFAT="mkfs.fat"
else
    UEFI_MISSING="$UEFI_MISSING mkfs.vfat"
fi
command -v mcopy >/dev/null 2>&1 || UEFI_MISSING="$UEFI_MISSING mcopy"
if [ -z "$UEFI_MISSING" ]; then
    RPG_UEFI=1
fi

clear
echo "_ _ _"
echo "Résumé avant création"
echo "---"
echo "Nom              : $RPGBUILDNAME"
echo "Kernel           : $VMLINUZ"
echo "Version kernel   : $KERNEL"
echo "Architecture     : $ARCH"
echo "Dossiers inclus  : $ROOTDIR"
echo "ISO de sortie    : $RPGHOME"
echo "Dossier de build : /respinguy-build-dir/"
echo "Label ISO        : $ISOLABEL"
if [ "$RPG_UEFI" -eq 1 ]; then
    echo "Demarrage        : BIOS + UEFI"
else
    echo "Demarrage        : BIOS uniquement"
fi
if   [ -n "$RPGCONFIGUSER" ];     then echo "Home utilisateur : $HOME (ISO uniquement)"
elif [ -n "$RPGCONFIGUSERPERS" ]; then echo "Home utilisateur : $HOME (ISO + persistance)"
else                                   echo "Home utilisateur : non inclus"
fi
echo "_ _ _"
if [ "$RPG_UEFI" -eq 0 ]; then
    echo ""
    echo "[ATTENTION] Outils UEFI manquants : l'ISO sera BIOS uniquement."
    echo "            Manquant :$UEFI_MISSING"
    echo "            Debian/Ubuntu : apt install grub-efi-amd64-bin dosfstools mtools"
    echo "            Fedora/RHEL   : dnf install grub2-tools-extra grub2-efi-x64-modules dosfstools mtools"
    echo "            Arch          : pacman -S grub dosfstools mtools"
    echo "            openSUSE      : zypper install grub2-x86_64-efi dosfstools mtools"
fi
rm -rf /respinguy-build-dir/
echo "Démarrage dans 1 seconde..."
sleep 1

cd / || exit 1
mkdir -p /respinguy-build-dir/LiveOS
mkdir -p /respinguy-build-dir/isolinux

# Archive du /etc d'origine : l'installateur la restaure sur le disque cible
# (le /etc du live contient un fstab tmpfs, des services masqués, etc.)
echo "Sauvegarde du /etc d'origine pour l'installateur..."
if tar --help 2>&1 | grep -q -- '--xattrs'; then
    tar -C / -cpf /respinguy-build-dir/LiveOS/etc-original.tar --xattrs --acls etc 2>/dev/null \
        || tar -C / -cpf /respinguy-build-dir/LiveOS/etc-original.tar etc
else
    tar -C / -cpf /respinguy-build-dir/LiveOS/etc-original.tar etc
fi

rpg_step 10 "Préparation de l'arborescence"
cp -r /usr/share/ResPinGuy-File/fichier/iso/isolinux/. /respinguy-build-dir/isolinux/
cp /usr/share/ResPinGuy-File-Config/bootimg.png /respinguy-build-dir/isolinux/

# Menu BIOS genere avec le label de l'ISO
cat > /respinguy-build-dir/isolinux/isolinux.cfg <<EOF
ui menu.c32
prompt 0
menu title ResPinGuy
timeout 30
menu background /isolinux/bootimg.png

label respinguy
    menu label ResPinGuy - Live
    menu default
    linux /vmlinuz
    append initrd=/initrd $BOOTARGS quiet $MASKS

label respinguy-novga
    menu label ResPinGuy - Live (no modeset)
    linux /vmlinuz
    append initrd=/initrd $BOOTARGS nomodeset $MASKS

label respinguy-debug
    menu label ResPinGuy - Live (debug)
    linux /vmlinuz
    append initrd=/initrd $BOOTARGS rd.debug rd.info $MASKS
EOF

if [ -n "$RPGHOME" ] && [ "$RPGHOME" != "/" ]; then
    rm -rf "$RPGHOME" && mkdir -p "$RPGHOME"
else
    echo "[ERREUR] RPGHOME invalide : '$RPGHOME'"; exit 1
fi

cp "$VMLINUZ" /respinguy-build-dir/vmlinuz || { echo "[ERREUR] Copie kernel impossible."; exit 1; }
rpg_step 20 "Noyau copié"
sleep 1
clear

if [ -n "$RPGCONFIGUSER" ]; then
    bash /usr/share/ResPinGuy-File/script/rcu || exit 1
elif [ -n "$RPGCONFIGUSERPERS" ]; then
    bash /usr/share/ResPinGuy-File/script/rcup || exit 1
fi

#_____________________________________________________________________________________________
# PRÉPARATION DU /etc LIVE
# On copie /etc dans un dossier temporaire et on y remplace fstab.
# Le système source n'est JAMAIS modifié.
# mksquashfs reçoit le dossier /etc temporaire à la place du vrai /etc.
rpg_step 30 "Préparation du /etc live"
RPG_ETC_ROOT=$(mktemp -d /tmp/rpg-live.XXXXXX)
RPG_ETC_TMP="$RPG_ETC_ROOT/etc"
mkdir -p "$RPG_ETC_TMP"
cp -a /etc/. "$RPG_ETC_TMP/"

cat > "$RPG_ETC_TMP/fstab" << 'FSTABEOF'
# /etc/fstab - ResPinGuy Live
# Généré automatiquement par ResPinGuy pour le démarrage en mode live.
# Les UUID du système source ont été retirés volontairement.
tmpfs   /tmp     tmpfs   defaults,noatime  0 0
tmpfs   /run     tmpfs   defaults,noatime  0 0
FSTABEOF

# Neutralise le crypttab du systeme source (evite les demandes de mot de passe au boot)
[ -f "$RPG_ETC_TMP/crypttab" ] && : > "$RPG_ETC_TMP/crypttab"

# Evite de dupliquer l'identifiant machine de la source sur le reseau
[ -f "$RPG_ETC_TMP/machine-id" ] && : > "$RPG_ETC_TMP/machine-id"

echo "[OK] /etc live préparé dans $RPG_ETC_TMP"

#_____________________________________________________________________________________________
# LIVE : autologin sans mot de passe + sudo NOPASSWD
# Ces modifications ne concernent que le live : l'installateur restaure le /etc
# d'origine (etc-original.tar) sur le disque cible.
if [ -f "$RPG_ETC_TMP/passwd" ]; then
    RPG_LIVE_USER=$(awk -F: '$3 == 1000 { print $1; exit }' "$RPG_ETC_TMP/passwd")
    [ -n "$RPG_LIVE_USER" ] || RPG_LIVE_USER=$(awk -F: '$3 >= 1000 && $3 < 65534 { print $1; exit }' "$RPG_ETC_TMP/passwd")
    [ -n "$RPG_LIVE_USER" ] || RPG_LIVE_USER="root"

    if grep -q "^$RPG_LIVE_USER:" "$RPG_ETC_TMP/shadow" 2>/dev/null; then
        sed -i "s/^$RPG_LIVE_USER:[^:]*:/$RPG_LIVE_USER::/" "$RPG_ETC_TMP/shadow"
    fi

    mkdir -p "$RPG_ETC_TMP/sudoers.d"
    printf '%s ALL=(ALL) NOPASSWD: ALL\n' "$RPG_LIVE_USER" > "$RPG_ETC_TMP/sudoers.d/99-respinguy-live"
    chmod 0440 "$RPG_ETC_TMP/sudoers.d/99-respinguy-live"

    HAS_DM=0
    [ -f "$RPG_ETC_TMP/X11/default-display-manager" ] && HAS_DM=1
    [ -d "$RPG_ETC_TMP/gdm3" ] && HAS_DM=1
    [ -d "$RPG_ETC_TMP/gdm" ] && HAS_DM=1
    [ -d "$RPG_ETC_TMP/lightdm" ] && HAS_DM=1
    [ -f "$RPG_ETC_TMP/sddm.conf" ] && HAS_DM=1
    [ -d "$RPG_ETC_TMP/sddm.conf.d" ] && HAS_DM=1

    for d in gdm3 gdm; do
        [ -d "$RPG_ETC_TMP/$d" ] || continue
        f="$RPG_ETC_TMP/$d/custom.conf"
        [ -f "$f" ] || printf '[daemon]\n' > "$f"
        grep -q '^\[daemon\]' "$f" || printf '\n[daemon]\n' >> "$f"
        if grep -q '^AutomaticLoginEnable=' "$f"; then
            sed -i 's/^AutomaticLoginEnable=.*/AutomaticLoginEnable=true/' "$f"
        else
            sed -i '/^\[daemon\]/a AutomaticLoginEnable=true' "$f"
        fi
        if grep -q '^AutomaticLogin=' "$f"; then
            sed -i "s/^AutomaticLogin=.*/AutomaticLogin=$RPG_LIVE_USER/" "$f"
        else
            sed -i "/^\[daemon\]/a AutomaticLogin=$RPG_LIVE_USER" "$f"
        fi
    done

    if [ -d "$RPG_ETC_TMP/lightdm" ]; then
        f="$RPG_ETC_TMP/lightdm/lightdm.conf"
        [ -f "$f" ] || : > "$f"
        grep -q '^\[Seat:\*\]' "$f" || printf '\n[Seat:*]\n' >> "$f"
        if grep -q '^autologin-user=' "$f"; then
            sed -i "s/^autologin-user=.*/autologin-user=$RPG_LIVE_USER/" "$f"
        else
            sed -i "/^\[Seat:\*\]/a autologin-user=$RPG_LIVE_USER" "$f"
        fi
        if grep -q '^autologin-user-timeout=' "$f"; then
            sed -i 's/^autologin-user-timeout=.*/autologin-user-timeout=0/' "$f"
        else
            sed -i '/^\[Seat:\*\]/a autologin-user-timeout=0' "$f"
        fi
    fi

    if [ -f "$RPG_ETC_TMP/sddm.conf" ] || [ -d "$RPG_ETC_TMP/sddm.conf.d" ]; then
        mkdir -p "$RPG_ETC_TMP/sddm.conf.d"
        printf '[Autologin]\nUser=%s\n' "$RPG_LIVE_USER" > "$RPG_ETC_TMP/sddm.conf.d/99-respinguy-autologin.conf"
    fi

    if [ "$HAS_DM" -eq 0 ]; then
        mkdir -p "$RPG_ETC_TMP/systemd/system/getty@tty1.service.d"
        cat > "$RPG_ETC_TMP/systemd/system/getty@tty1.service.d/autologin.conf" <<EOF
[Service]
ExecStart=
ExecStart=-/sbin/agetty --autologin $RPG_LIVE_USER --noclear %I \$TERM
EOF
    fi

    mkdir -p "$RPG_ETC_TMP/profile.d"
    cat > "$RPG_ETC_TMP/profile.d/99-respinguy-live.sh" <<EOF
# ResPinGuy live : "install" lance l'installateur
install() { sudo rpg-install "\$@"; }
EOF
    chmod 0644 "$RPG_ETC_TMP/profile.d/99-respinguy-live.sh"

    echo "[INFO] Live : utilisateur $RPG_LIVE_USER (autologin, sans mot de passe)"
fi

# Désactivation des services bloquants en mode live
# systemd cherche les overrides dans /etc/systemd/system/ EN PRIORITÉ sur /lib/systemd/system/
# Un symlink /etc/systemd/system/service.service -> /dev/null masque TOTALEMENT le service,
# même s'il existe dans /lib/systemd/system/
SYSTEMD_DIR="$RPG_ETC_TMP/systemd/system"
mkdir -p "$SYSTEMD_DIR"

# Copie des overrides existants depuis /etc/systemd/system/
if [ -d "/etc/systemd/system/" ]; then
    cp -a /etc/systemd/system/. "$SYSTEMD_DIR/" 2>/dev/null
fi

# Copie également des dossiers .wants et .requires depuis /lib/systemd/system/
# pour qu'on puisse supprimer les liens qui y activent les services bloquants
for WANTS_DIR in /lib/systemd/system/*.wants /lib/systemd/system/*.requires; do
    [ -d "$WANTS_DIR" ] || continue
    DIRNAME=$(basename "$WANTS_DIR")
    mkdir -p "$SYSTEMD_DIR/$DIRNAME"
    cp -a "$WANTS_DIR/." "$SYSTEMD_DIR/$DIRNAME/" 2>/dev/null
done

# Détection de la distro via /etc/os-release
DISTRO_ID=""
DISTRO_LIKE=""
if [ -f /etc/os-release ]; then
    DISTRO_ID=$(grep "^ID=" /etc/os-release | cut -d= -f2 | tr -d '"' | tr '[:upper:]' '[:lower:]')
    DISTRO_LIKE=$(grep "^ID_LIKE=" /etc/os-release | cut -d= -f2 | tr -d '"' | tr '[:upper:]' '[:lower:]')
fi
echo "[INFO] Distro détectée : $DISTRO_ID (famille : $DISTRO_LIKE)"

# Services à désactiver sur TOUTES les distros
SERVICES_COMMON="
    systemd-networkd-wait-online.service
    NetworkManager-wait-online.service
    systemd-resolved.service
"

# Services spécifiques Debian/Ubuntu
SERVICES_DEBIAN="
    rpcbind.service
    rpcbind.socket
    nftables.service
    keyboard-setup.service
    plymouth.service
    plymouth-quit.service
    plymouth-quit-wait.service
"

# Services spécifiques Fedora/RHEL/CentOS
SERVICES_RPM="
    firewalld.service
    rpcbind.service
    rpcbind.socket
    nftables.service
    plymouth.service
    plymouth-quit.service
    plymouth-quit-wait.service
    kdump.service
    abrtd.service
"

# Services spécifiques Arch/Manjaro
SERVICES_ARCH="
    iptables.service
    ip6tables.service
    nftables.service
    systemd-boot-update.service
"

# Services spécifiques OpenSUSE
SERVICES_OPENSUSE="
    firewalld.service
    nftables.service
    rpcbind.service
    rpcbind.socket
    wicked.service
    wickedd.service
"

# Construction de la liste finale selon la distro
SERVICES_TO_MASK="$SERVICES_COMMON"

case "$DISTRO_ID" in
    debian|ubuntu|linuxmint|pop|kali|raspbian|elementary|zorin)
        SERVICES_TO_MASK="$SERVICES_TO_MASK $SERVICES_DEBIAN" ;;
    fedora|rhel|centos|almalinux|rocky|ol)
        SERVICES_TO_MASK="$SERVICES_TO_MASK $SERVICES_RPM" ;;
    arch|manjaro|endeavouros|garuda)
        SERVICES_TO_MASK="$SERVICES_TO_MASK $SERVICES_ARCH" ;;
    opensuse*|sles)
        SERVICES_TO_MASK="$SERVICES_TO_MASK $SERVICES_OPENSUSE" ;;
    *)
        # Famille détectée via ID_LIKE
        case "$DISTRO_LIKE" in
            *debian*|*ubuntu*)
                SERVICES_TO_MASK="$SERVICES_TO_MASK $SERVICES_DEBIAN" ;;
            *fedora*|*rhel*|*centos*)
                SERVICES_TO_MASK="$SERVICES_TO_MASK $SERVICES_RPM" ;;
            *arch*)
                SERVICES_TO_MASK="$SERVICES_TO_MASK $SERVICES_ARCH" ;;
            *suse*)
                SERVICES_TO_MASK="$SERVICES_TO_MASK $SERVICES_OPENSUSE" ;;
            *)
                # Distro inconnue : on applique tous les services par sécurité
                SERVICES_TO_MASK="$SERVICES_TO_MASK $SERVICES_DEBIAN $SERVICES_RPM $SERVICES_ARCH $SERVICES_OPENSUSE"
                echo "[INFO] Distro inconnue, désactivation large des services bloquants." ;;
        esac ;;
esac

# Application du masquage
for SERVICE in $SERVICES_TO_MASK; do
    [ -z "$SERVICE" ] && continue
    ln -sf /dev/null "$SYSTEMD_DIR/$SERVICE"
    find "$SYSTEMD_DIR" -name "$SERVICE" -type l ! -path "$SYSTEMD_DIR/$SERVICE" -delete 2>/dev/null
done

echo "[OK] Services bloquants désactivés pour le live."

#_____________________________________________________________________________________________
# CONSTRUCTION DE LA LISTE DES DOSSIERS POUR mksquashfs
# On remplace /etc par le dossier temporaire dans la liste des sources.
rpg_step 45 "Création du squashfs"
SQSFDIR=""
for i in $ROOTDIR; do
    if [ "$i" = "etc" ]; then
        # On utilise le /etc temporaire à la place du vrai
        [ -d "$RPG_ETC_TMP" ] && SQSFDIR="$SQSFDIR $RPG_ETC_TMP"
    else
        [ -d "/$i" ] && SQSFDIR="$SQSFDIR /$i"
    fi
done

if [ -z "$SQSFDIR" ]; then
    echo "[ERREUR] Aucun dossier valide dans ROOTDIR."
    rm -rf "$RPG_ETC_ROOT"
    exit 1
fi

mksquashfs $SQSFDIR /respinguy-build-dir/LiveOS/squashfs.img \
    -comp xz \
    -b 1024K \
    -always-use-fragments \
    -keep-as-directory \
    -noappend \
    -wildcards \
    -e "proc/*"  "proc/.*" \
    -e "run/*"   "run/.*" \
    -e "tmp/*"   "tmp/.*" \
    -e "sys/*"   "sys/.*" \
    -e "dev/*" \
    -e "var/crash/*" \
    -e "var/tmp/*" \
    -e "root/.bash_history" "root/.cache" "root/.wget-hsts" \
    -e "home/*/.bash_history" "home/*/.cache" "home/*/.wget-hsts" \
    -e "boot/efi" "boot/efi/*" \
    -e "usr/sbin/rpcbind" \
    -e "lib/systemd/system/rpcbind*" \
    -e "lib/systemd/system/nfs*" \
    -e "lib/systemd/system/nftables*" \
    -e "usr/sbin/nft" \
    -e "lib/systemd/system/keyboard-setup*" \
    -e "lib/systemd/system/systemd-networkd-wait-online*"

SQUASHFS_RESULT=$?
rm -rf "$RPG_ETC_ROOT"

if [ $SQUASHFS_RESULT -ne 0 ]; then
    echo "[ERREUR] Échec de la création du squashfs."
    exit 1
fi

rpg_step 60 "Squashfs créé : $(du -sh /respinguy-build-dir/LiveOS/squashfs.img | cut -f1)"
sleep 1

if [ -n "$RPGCONFIGUSER" ]; then
    bash /usr/share/ResPinGuy-File/script/rcurm
fi

#_____________________________________________________________________________________________
rpg_step 70 "Création de l'initrd"
dracut -N -a dmsquash-live --kver "$KERNEL" /respinguy-build-dir/initrd --force

if [ $? -ne 0 ]; then echo "[ERREUR] Échec de la création de l'initrd."; exit 1; fi
rpg_step 80 "Initrd créé : $(du -sh /respinguy-build-dir/initrd | cut -f1)"
sleep 1

#_____________________________________________________________________________________________
# Demarrage UEFI (GRUB)
if [ "$RPG_UEFI" -eq 1 ]; then
    rpg_step 85 "Préparation du démarrage UEFI"
    mkdir -p /respinguy-build-dir/boot
    cat > /respinguy-build-dir/grub.cfg <<EOF
set timeout=30
set default=0

search --no-floppy --label $ISOLABEL --set=root

menuentry "ResPinGuy - Live" {
    linux /vmlinuz $BOOTARGS quiet $MASKS
    initrd /initrd
}

menuentry "ResPinGuy - Live (no modeset)" {
    linux /vmlinuz $BOOTARGS nomodeset $MASKS
    initrd /initrd
}

menuentry "ResPinGuy - Live (debug)" {
    linux /vmlinuz $BOOTARGS rd.debug rd.info $MASKS
    initrd /initrd
}
EOF

    if "$GRUB_MKSTANDALONE" --directory="$GRUB_EFI_DIR" --format=x86_64-efi \
        --output=/respinguy-build-dir/BOOTX64.EFI \
        --modules="part_gpt part_msdos fat iso9660 normal linux configfile search search_label search_fs_uuid search_fs_file echo test true sleep reboot halt" \
        "boot/grub/grub.cfg=/respinguy-build-dir/grub.cfg"; then
        dd if=/dev/zero of=/respinguy-build-dir/boot/efi.img bs=1M count=32 2>/dev/null
        if "$MKFS_VFAT" -F 16 -n EFIBOOT /respinguy-build-dir/boot/efi.img >/dev/null 2>&1 \
           && mmd -i /respinguy-build-dir/boot/efi.img ::/EFI ::/EFI/BOOT \
           && mcopy -i /respinguy-build-dir/boot/efi.img /respinguy-build-dir/BOOTX64.EFI ::/EFI/BOOT/BOOTX64.EFI; then
            rm -f /respinguy-build-dir/BOOTX64.EFI /respinguy-build-dir/grub.cfg
            echo "[OK] Démarrage UEFI prêt."
        else
            echo "[ATTENTION] Échec de la préparation de l'image EFI : ISO BIOS uniquement."
            RPG_UEFI=0
        fi
    else
        echo "[ATTENTION] Échec de grub-mkstandalone : ISO BIOS uniquement."
        RPG_UEFI=0
    fi
fi

sleep 1

#_____________________________________________________________________________________________
rpg_step 90 "Création de l'image ISO"
cd / || exit 1
XORRISO_UEFI=()
if [ "$RPG_UEFI" -eq 1 ]; then
    XORRISO_UEFI=(-eltorito-alt-boot -e boot/efi.img -no-emul-boot -isohybrid-gpt-basdat)
fi
xorriso -as mkisofs \
    -r -J -joliet-long -l -iso-level 3 -cache-inodes \
    -isohybrid-mbr /usr/share/ResPinGuy-File/fichier/isohdpfx.bin \
    -partition_offset 16 -A "$RPGBUILDNAME" -V "$ISOLABEL" \
    -b isolinux/isolinux.bin -c isolinux/boot.cat \
    -no-emul-boot -boot-load-size 4 -boot-info-table \
    "${XORRISO_UEFI[@]}" \
    -o "$RPGHOME/$RPGBUILDNAME-$ARCH.iso" \
    /respinguy-build-dir/

if [ $? -ne 0 ]; then echo "[ERREUR] Échec de la création de l'ISO."; exit 1; fi

clear
echo "_ _ _"
rpg_step 100 "Build terminé avec succès !"
echo "ISO : $RPGHOME/$RPGBUILDNAME-$ARCH.iso"
echo "Taille : $(du -sh "$RPGHOME/$RPGBUILDNAME-$ARCH.iso" | cut -f1)"
if [ "$RPG_UEFI" -eq 1 ]; then
    echo "Demarrage : BIOS + UEFI"
else
    echo "Demarrage : BIOS uniquement"
fi
echo "_ _ _"
