#!/bin/bash
#----------------------------------------------------------------------------------------------
# ResPinGuy - prépare le bureau du live
# Place l'installateur graphique sur le bureau de l'utilisateur live.
# Ce script est lancé par l'autostart de session ; il ne modifie que ~/Desktop
# (overlay du live), jamais le système source.
#----------------------------------------------------------------------------------------------
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin${PATH:+:$PATH}"
LOG="/tmp/respinguy-live-desktop.log"
: > "$LOG" 2>/dev/null || true
exec >> "$LOG" 2>&1

[ -n "${HOME-}" ] || exit 0
[ -n "${DISPLAY-}${WAYLAND_DISPLAY-}" ] || exit 0

[ -f /usr/share/ResPinGuy-File/respinguy-gui-launch ] || {
    echo "Lanceur graphique absent : /usr/share/ResPinGuy-File/respinguy-gui-launch"
    exit 0
}

desktop_dir=""
if command -v xdg-user-dir >/dev/null 2>&1; then
    desktop_dir=$(xdg-user-dir DESKTOP 2>/dev/null)
fi
if [ -z "$desktop_dir" ] || [ "$desktop_dir" = "$HOME" ]; then
    if [ -d "$HOME/Bureau" ] && [ ! -d "$HOME/Desktop" ]; then
        desktop_dir="$HOME/Bureau"
    else
        desktop_dir="$HOME/Desktop"
    fi
fi

mkdir -p "$desktop_dir" 2>/dev/null || exit 0

place_icon() {
    local src="$1"
    local name="$2"
    local dst="$desktop_dir/$name"
    [ -f "$src" ] || { echo "Lanceur absent : $src"; return 0; }
    # Remplace un ancien fichier (ou un lien symbolique) sans toucher a la source.
    rm -f "$dst" 2>/dev/null || true
    # Certains transferts Windows/Linux laissent des CRLF : on nettoie.
    if ! sed '1s/^\xEF\xBB\xBF//; s/\r$//' "$src" > "$dst" 2>/dev/null; then
        cp -f "$src" "$dst" 2>/dev/null || return 0
    fi
    chmod 0755 "$dst" 2>/dev/null || true
    if command -v gio >/dev/null 2>&1; then
        gio set "$dst" metadata::trusted true 2>/dev/null || true
    fi
    echo "Lanceur placé : $dst"
}

place_icon "/usr/share/applications/respinguy-install-g.desktop" "Installer ResPinGuy.desktop"
place_icon "/usr/share/applications/respinguy-g.desktop" "ResPinGuy.desktop"

if command -v notify-send >/dev/null 2>&1; then
    notify-send -i respinguy -a ResPinGuy \
        "ResPinGuy" "L'installateur est disponible sur le bureau." 2>/dev/null || true
fi

exit 0
