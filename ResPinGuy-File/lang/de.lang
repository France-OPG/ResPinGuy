# Hilfe
L_HELP_TITLE="Hilfe"
L_HELP_BODY="ResPinGuy
ISO-Abbild des eigenen Linux-Systems erstellen.

OBERFLÄCHE
  respinguy               Dieses Menü
  respinguy --build       Direkter Build
  respinguy --config      Direkte Konfiguration
  respinguy --deps        Abhängigkeiten prüfen

BEFEHLE
  respinguy-build         ISO-Abbild erstellen
  respinguy-config        Konfiguration bearbeiten
  respinguy-app-dep       Abhängigkeiten prüfen
  respinguy-app-dep-force-install
                          Fehlende Abhängigkeiten installieren
  respinguy-app-up        ResPinGuy aktualisieren
  respinguy-app-rm        ResPinGuy entfernen
  respinguy-install       System installieren (nur Live)

DATEIEN
  /usr/share/ResPinGuy-File-Config/respinguy-config
                          Standardkonfiguration
  /usr/share/ResPinGuy-File-Config/respinguy-config.local
                          Von der Oberfläche gespeicherte Einstellungen

DOKUMENTATION
  https://github.com/France-OPG/ResPinGuy

UMGEBUNG
  RPG_UI_ENGINE=basic     Erzwingt das Textmenü (Live-Größenänderung)
  RPG_FORCE_COLOR=1       Erzwingt ANSI-Farben im Textmenü
  NO_COLOR=1              Deaktiviert Farben
  RPG_NO_MOUSE=1          Deaktiviert die Maus im Textmenü

ResPinGuy Offiziell [r]"

L_USAGE="Verwendung: respinguy [--build|--config|--deps|--lang|--help]"
