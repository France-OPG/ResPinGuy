# Aide
L_HELP_TITLE="Aide"
L_HELP_BODY="ResPinGuy
Créer une image ISO de son système Linux.

INTERFACE
  respinguy               Ce menu
  respinguy --build       Build direct
  respinguy --config      Configuration directe
  respinguy --deps        Vérification des dépendances

COMMANDES
  respinguy-build         Créer l'image ISO
  respinguy-config        Modifier la configuration
  respinguy-app-dep       Vérifier les dépendances
  respinguy-app-dep-force-install
                          Installer les dépendances manquantes
  respinguy-app-up        Mettre à jour ResPinGuy
  respinguy-app-rm        Supprimer ResPinGuy

FICHIERS
  /usr/share/ResPinGuy-File-Config/respinguy-config
                          Configuration par défaut
  /usr/share/ResPinGuy-File-Config/respinguy-config.local
                          Réglages enregistrés par l'interface

DOCUMENTATION
  https://github.com/France-OPG/ResPinGuy

ENVIRONNEMENT
  RPG_UI_ENGINE=basic     Force le menu texte (redimensionnement en direct)
  RPG_FORCE_COLOR=1       Force les couleurs ANSI du menu texte
  NO_COLOR=1              Désactive les couleurs

ResPinGuy Officiel [r]"

L_USAGE="Usage : respinguy [--build|--config|--deps|--lang|--help]"
