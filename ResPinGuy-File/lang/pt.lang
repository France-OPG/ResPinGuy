# Ajuda
L_HELP_TITLE="Ajuda"
L_HELP_BODY="ResPinGuy
Criar uma imagem ISO do seu sistema Linux.

INTERFACE
  respinguy               Este menu
  respinguy --build       Compilação direta
  respinguy --config      Configuração direta
  respinguy --deps        Verificação de dependências

COMANDOS
  respinguy-build         Criar a imagem ISO
  respinguy-config        Editar a configuração
  respinguy-app-dep       Verificar dependências
  respinguy-app-dep-force-install
                          Instalar dependências faltantes
  respinguy-app-up        Atualizar ResPinGuy
  respinguy-app-rm        Remover ResPinGuy
  rpg-install             Instalar o sistema (apenas live)

ARQUIVOS
  /usr/share/ResPinGuy-File-Config/respinguy-config
                          Configuração padrão
  /usr/share/ResPinGuy-File-Config/respinguy-config.local
                          Configurações salvas pela interface

DOCUMENTAÇÃO
  https://github.com/France-OPG/ResPinGuy

AMBIENTE
  RPG_UI_ENGINE=basic     Força o menu de texto (redimensionamento ao vivo)
  RPG_FORCE_COLOR=1       Força as cores ANSI do menu de texto
  NO_COLOR=1              Desativa as cores
  RPG_NO_MOUSE=1          Desativa o mouse no menu de texto

ResPinGuy Oficial [r]"

L_USAGE="Uso: respinguy [--build|--config|--deps|--lang|--help]"
