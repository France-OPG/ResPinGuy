# Ayuda
L_HELP_TITLE="Ayuda"
L_HELP_BODY="ResPinGuy
Crear una imagen ISO de tu sistema Linux.

INTERFAZ
  respinguy               Este menú
  respinguy --build       Compilación directa
  respinguy --config      Configuración directa
  respinguy --deps        Comprobación de dependencias

COMANDOS
  respinguy-build         Crear la imagen ISO
  respinguy-config        Editar la configuración
  respinguy-app-dep       Comprobar dependencias
  respinguy-app-dep-force-install
                          Instalar dependencias faltantes
  respinguy-app-up        Actualizar ResPinGuy
  respinguy-app-rm        Eliminar ResPinGuy

ARCHIVOS
  /usr/share/ResPinGuy-File-Config/respinguy-config
                          Configuración por defecto
  /usr/share/ResPinGuy-File-Config/respinguy-config.local
                          Ajustes guardados por la interfaz

DOCUMENTACIÓN
  https://github.com/France-OPG/ResPinGuy

ENTORNO
  RPG_UI_ENGINE=basic     Fuerza el menú de texto (redimensionado en vivo)
  RPG_FORCE_COLOR=1       Fuerza los colores ANSI del menú de texto
  NO_COLOR=1              Desactiva los colores

ResPinGuy Oficial [r]"

L_USAGE="Uso: respinguy [--build|--config|--deps|--lang|--help]"
