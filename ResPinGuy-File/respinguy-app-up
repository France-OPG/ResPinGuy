#!/bin/bash
allow_only_root() {
  if [ "0$UID" -ne 0 ]; then echo "Merci d'être en root pour lancer : $(basename $0)"; exit 1; fi
}
allow_only_root
clear
bash /usr/share/ResPinGuy-File/respinguy-app-dep
if [ $? -ne 0 ]; then echo "[ERREUR] Dépendances manquantes. Mise à jour annulée."; exit 1; fi
cd /tmp/ || exit 1
rm -rf /tmp/ResPinGuy
git clone https://github.com/France-OPG/ResPinGuy.git
if [ $? -ne 0 ]; then echo "[ERREUR] Échec du clonage GitHub."; exit 1; fi
cd ResPinGuy || exit 1
read -p "Appuyez sur Entrée pour continuer la mise à jour..."
cp ./ResPinGuy-CMD/respinguy /usr/bin/         && chmod +x /usr/bin/respinguy         && echo "... [1/10]"
cp ./ResPinGuy-CMD/respinguy-app-rm /usr/bin/  && chmod +x /usr/bin/respinguy-app-rm  && echo "... [2/10]"
cp ./ResPinGuy-CMD/respinguy-app-up /usr/bin/  && chmod +x /usr/bin/respinguy-app-up  && echo "... [3/10]"
cp ./ResPinGuy-CMD/respinguy-build /usr/bin/   && chmod +x /usr/bin/respinguy-build   && echo "... [4/10]"
cp ./ResPinGuy-CMD/respinguy-config /usr/bin/  && chmod +x /usr/bin/respinguy-config  && echo "... [5/10]"
cp ./ResPinGuy-CMD/respinguy-app-dep /usr/bin/ && chmod +x /usr/bin/respinguy-app-dep && echo "... [6/10]"
cp ./ResPinGuy-CMD/respinguy-app-dep-force-install /usr/bin/ && chmod +x /usr/bin/respinguy-app-dep-force-install && echo "... [7/10]"
cp ./ResPinGuy-CMD/install /usr/local/bin/install && chmod +x /usr/local/bin/install && echo "... [8/10]"
cp ./ResPinGuy-CMD/rpg-install /usr/bin/ && chmod +x /usr/bin/rpg-install && echo "... [9/10]"
cp ./ResPinGuy-GUI/respinguy-g /usr/bin/ && chmod +x /usr/bin/respinguy-g && sed -i 's/\r$//' /usr/bin/respinguy-g && echo "... [10/10]"
rm -f /usr/bin/respinguy-install
echo "Les commandes sont mises à jour."
cp -r ResPinGuy-File/ /usr/share/ && echo "... [1/5]"
sed -i 's/\r$//' /usr/share/ResPinGuy-File/respinguy-gui-launch /usr/share/ResPinGuy-File/respinguy-live-desktop 2>/dev/null || true
cp -r ResPinGuy-File-Config/ /usr/share/ && echo "... [2/5]"
rm -rf /usr/share/respinguy-gui
cp -r ResPinGuy-GUI/ /usr/share/respinguy-gui && echo "... [3/5]"
mkdir -p /usr/share/applications /usr/share/icons/hicolor/scalable/apps
cp -f ResPinGuy-GUI/desktop/respinguy-g.desktop /usr/share/applications/ && \
cp -f ResPinGuy-GUI/desktop/respinguy-install-g.desktop /usr/share/applications/ && \
chmod 0755 /usr/share/applications/respinguy-g.desktop /usr/share/applications/respinguy-install-g.desktop && \
{ sed -i '1s/^\xEF\xBB\xBF//; s/\r$//' /usr/share/applications/respinguy-g.desktop /usr/share/applications/respinguy-install-g.desktop 2>/dev/null || true; } && \
echo "... [4/5]"
cp -f ResPinGuy-GUI/assets/respinguy.svg /usr/share/icons/hicolor/scalable/apps/respinguy.svg && \
chmod 0644 /usr/share/icons/hicolor/scalable/apps/respinguy.svg && echo "... [5/5]"
command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database -q /usr/share/applications 2>/dev/null || true
command -v gtk-update-icon-cache >/dev/null 2>&1 && gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true
echo "Les fichiers sont mis à jour."
cd /tmp/ && rm -rf ResPinGuy && cd ~
clear
echo "---"
echo "Mise à jour terminée."
echo "---"
