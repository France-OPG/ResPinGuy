#!/bin/bash
#_____________________________________________________________________________________________
# ResPinGuy
# Interface texte (TUI) : accueil, build, configuration, dependances,
# mise a jour et suppression.
#
# Emplacement : /usr/share/ResPinGuy-File/respinguy
# Lancee par  : respinguy / respinguy --build / --config / --deps / --help
#
# Moteur d'affichage : whiptail, sinon dialog, sinon menu texte simple.
# Aucune dependance supplementaire n'est obligatoire.
#_____________________________________________________________________________________________

RPG_FILE_DIR="/usr/share/ResPinGuy-File"
RPG_CONF_DIR="/usr/share/ResPinGuy-File-Config"
RPG_CONF="$RPG_CONF_DIR/respinguy-config"
RPG_LOCAL="$RPG_CONF_DIR/respinguy-config.local"
RPG_LANG_DIR="$RPG_FILE_DIR/lang"
RPG_LANG="${RPG_LANG-}"
RPG_BACKTITLE="ResPinGuy"
RPG_VERSION=$(cat "$RPG_FILE_DIR/VERSION" 2>/dev/null | head -n1)
[ -n "$RPG_VERSION" ] || RPG_VERSION="0.35"

# Palette officielle
RPG_HEX_NAVY="#1d2f52"
RPG_HEX_GREEN="#73ba25"
RPG_HEX_RED="#ee0000"
RPG_HEX_AMBER="#ffb516"
RPG_HEX_WHITE="#ffffff"

# Tailles recalculees avant chaque ecran (voir rpg_ui_size)
UI_H=21
UI_W=76

# Couleurs ANSI du menu texte (fallback) :
# fond noir, texte jaune, cadre bleu.
if [ -n "${RPG_FORCE_COLOR-}" ] || { [ -t 2 ] && [ -z "${NO_COLOR-}" ]; }; then
    C_RESET=$'\033[0m'
    C_BOLD=$'\033[1m'
    C_BLACK_BG=$'\033[48;2;0;0;0m'
    C_YELLOW=$'\033[38;2;255;181;22m'
    C_BLUE=$'\033[38;2;29;47;82m'
else
    C_RESET=""
    C_BOLD=""
    C_BLACK_BG=""
    C_YELLOW=""
    C_BLUE=""
fi

# Themes whiptail via NEWT_COLORS.
# newt n'accepte que les couleurs du terminal, pas le code hex :
# fond noir, texte jaune, cadre bleu ; selection jaune sur vert,
# boutons jaune sur rouge.
RPG_NEWT_NORMAL='root=yellow,black
window=yellow,black
border=blue,black
title=yellow,black
button=yellow,red
actbutton=yellow,red
compactbutton=yellow,red
entry=yellow,blue
label=yellow,black
listbox=yellow,black
actlistbox=yellow,black
sellistbox=yellow,green
actsellistbox=yellow,green
textbox=yellow,black
acttextbox=yellow,black
helpline=yellow,black
roottext=yellow,black
disentry=gray,black'

RPG_NEWT_DANGER='root=yellow,black
window=yellow,black
border=red,black
title=yellow,black
button=yellow,red
actbutton=yellow,red
compactbutton=yellow,red
entry=yellow,blue
label=yellow,black
listbox=yellow,black
actlistbox=yellow,black
sellistbox=yellow,green
actsellistbox=yellow,green
textbox=yellow,black
acttextbox=yellow,black
helpline=yellow,black
roottext=yellow,black'

RPG_NEWT_THEME="$RPG_NEWT_NORMAL"

RPG_UI="basic"
DEPS_STATE="?"

DISTRO_NAME=""
if [ -r /etc/os-release ]; then
    . /etc/os-release
    DISTRO_NAME="${PRETTY_NAME:-${NAME:-}}"
fi

# Etat de la configuration (recharge a chaque passage dans les menus)
CFG_NAME=""
CFG_OUT=""
CFG_MODE="none"
CFG_HOME=""
CFG_KERNEL=""
CFG_ARCH=""
CFG_VMLINUZ=""
CFG_ROOTDIR=""
CFG_KVER_FORCED=0
CFG_KVML_FORCED=0
CFG_ROOTDIR_SET=0

DEFAULT_ROOTDIR="bin boot etc home lib lib64 opt root sbin srv usr var"


#_____________________________________________________________________________________________
# Verification des droits

allow_only_root() {
    if [ "0$UID" -ne 0 ]; then
        echo "Merci d'etre en root pour lancer : $(basename "$0")"
        exit 1
    fi
}
allow_only_root

#_____________________________________________________________________________________________
# Langue de l'interface

rpg_detect_lang() {
    local l="${RPG_LANG-}"
    if [ -z "$l" ] && [ -f "$RPG_LOCAL" ]; then
        l=$(sed -n 's/^RPG_LANG=//p' "$RPG_LOCAL" 2>/dev/null | tail -n 1 | tr -d "\"'")
    fi
    case "$l" in
        fr|en|es|de|pt) printf '%s' "$l" ;;
        *) printf 'fr' ;;
    esac
}

rpg_load_lang() {
    local lang="${1:-fr}"
    case "$lang" in
        fr|en|es|de|pt) ;;
        *) lang="fr" ;;
    esac
    RPG_LANG="$lang"
    [ -f "$RPG_LANG_DIR/fr.lang" ] && . "$RPG_LANG_DIR/fr.lang"
    if [ "$lang" != "fr" ] && [ -f "$RPG_LANG_DIR/$lang.lang" ]; then
        . "$RPG_LANG_DIR/$lang.lang"
    fi
}

#_____________________________________________________________________________________________
# Detection du moteur d'interface

ui_is_tty() {
    [ -t 0 ] && [ -t 1 ]
}

detect_ui() {
    case "${RPG_UI_ENGINE-}" in
        basic|whiptail|dialog)
            RPG_UI="$RPG_UI_ENGINE"
            return ;;
    esac
    if ! ui_is_tty || [ -z "${TERM-}" ]; then
        RPG_UI="basic"
        return
    fi
    if command -v whiptail >/dev/null 2>&1; then
        RPG_UI="whiptail"
    elif command -v dialog >/dev/null 2>&1; then
        RPG_UI="dialog"
    else
        RPG_UI="basic"
    fi
}

#_____________________________________________________________________________________________
# Taille dynamique de la fenetre

rpg_ui_size() {
    local sz lines cols

    lines=""
    cols=""
    sz=$(stty size 2>/dev/null)
    if [ -n "$sz" ]; then
        lines=${sz%% *}
        cols=${sz##* }
    fi

    case "$lines" in
        ''|*[!0-9]*) lines=$(tput lines 2>/dev/null) ;;
    esac
    case "$cols" in
        ''|*[!0-9]*) cols=$(tput cols 2>/dev/null) ;;
    esac
    case "$lines" in
        ''|*[!0-9]*) lines=24 ;;
    esac
    case "$cols" in
        ''|*[!0-9]*) cols=80 ;;
    esac

    [ "$lines" -lt 15 ] && lines=15
    [ "$cols" -lt 60 ] && cols=60

    UI_H=$((lines - 3))
    UI_W=$((cols - 4))
    [ "$UI_W" -gt 140 ] && UI_W=140
}

rpg_term_cols() {
    local sz cols
    sz=$(stty size 2>/dev/null)
    cols=${sz##* }
    case "$cols" in
        ''|*[!0-9]*) cols=$(tput cols 2>/dev/null) ;;
    esac
    case "$cols" in
        ''|*[!0-9]*) cols=80 ;;
    esac
    [ "$cols" -lt 40 ] && cols=40
    printf '%s' "$cols"
}

# Taille brute du terminal ("lignes colonnes")
rpg_term_size_str() {
    local sz
    sz=$(stty size 2>/dev/null)
    [ -n "$sz" ] || sz="24 80"
    printf '%s' "$sz"
}

# Ligne du haut : "ResPinGuy" a gauche, version a droite (backtitle whiptail)
rpg_backtitle() {
    local cols pad
    cols=$(rpg_term_cols)
    pad=$((cols - ${#RPG_BACKTITLE} - ${#RPG_VERSION} - 2))
    [ "$pad" -lt 1 ] && pad=1
    printf '%s%*s%s' "$RPG_BACKTITLE" "$pad" "" "$RPG_VERSION"
}

# Hauteur adaptee au contenu (msgbox, yesno)
rpg_ui_text_height() {
    local n
    n=$(printf '%s\n' "$1" | wc -l)
    n=$((n + 6))
    [ "$n" -lt 12 ] && n=12
    [ "$n" -gt "$UI_H" ] && n=$UI_H
    printf '%s' "$n"
}

#_____________________________________________________________________________________________
# Couche d'affichage : whiptail / dialog

ui_menu() {
    local title="$1"
    local prompt="$2"
    local num listh h cancel
    shift 2

    if [ "$RPG_UI" = "basic" ]; then
        basic_menu "$title" "$prompt" "$@"
        return
    fi

    rpg_ui_size
    num=$(( $# / 2 ))
    listh=$num
    h=$((num + 8))
    [ "$h" -gt "$UI_H" ] && h=$UI_H
    [ "$h" -lt 10 ] && h=10
    [ "$listh" -gt $((h - 7)) ] && listh=$((h - 7))
    [ "$listh" -lt 1 ] && listh=1

    cancel="$L_BTN_BACK"
    [ "${UI_CANCEL_KEY-}" = "quit" ] && cancel="$L_BTN_QUIT"

    NEWT_COLORS="$RPG_NEWT_THEME" "$RPG_UI" \
        --title "$title" --backtitle "$(rpg_backtitle)" \
        --cancel-button "$cancel" --ok-button "$L_BTN_VALIDATE" \
        --menu "$prompt" "$h" "$UI_W" "$listh" "$@" 3>&1 1>&2 2>&3
}

ui_input() {
    local title="$1"
    local prompt="$2"
    local def="${3-}"
    local h

    if [ "$RPG_UI" = "basic" ]; then
        basic_input "$title" "$prompt" "$def"
        return
    fi

    rpg_ui_size
    h=12
    [ "$h" -gt "$UI_H" ] && h=$UI_H

    NEWT_COLORS="$RPG_NEWT_THEME" "$RPG_UI" \
        --title "$title" --backtitle "$(rpg_backtitle)" \
        --cancel-button "$L_BTN_CANCEL" --ok-button "$L_BTN_VALIDATE" \
        --inputbox "$prompt" "$h" "$UI_W" "$def" 3>&1 1>&2 2>&3
}

ui_yesno() {
    local title="$1"
    local text="$2"
    local kind="${3-}"
    local theme h

    if [ "$RPG_UI" = "basic" ]; then
        basic_yesno "$title" "$text" "$kind"
        return
    fi

    rpg_ui_size
    h=$(rpg_ui_text_height "$text")
    theme="$RPG_NEWT_THEME"
    [ "$kind" = "danger" ] && theme="$RPG_NEWT_DANGER"

    NEWT_COLORS="$theme" "$RPG_UI" \
        --title "$title" --backtitle "$(rpg_backtitle)" \
        --yes-button "$L_BTN_YES" --no-button "$L_BTN_NO" \
        --yesno "$text" "$h" "$UI_W"
}

ui_msg() {
    local title="$1"
    local text="$2"
    local kind="${3-}"
    local theme h

    if [ "$RPG_UI" = "basic" ]; then
        basic_msg "$title" "$text" "$kind"
        return
    fi

    rpg_ui_size
    h=$(rpg_ui_text_height "$text")
    theme="$RPG_NEWT_THEME"
    [ "$kind" = "error" ] && theme="$RPG_NEWT_DANGER"

    NEWT_COLORS="$theme" "$RPG_UI" \
        --title "$title" --backtitle "$(rpg_backtitle)" \
        --ok-button "$L_BTN_OK" --msgbox "$text" "$h" "$UI_W"
}

ui_error() {
    ui_msg "$1" "$2" "error"
}

ui_text() {
    local title="$1"
    local text="$2"
    local tmp rc

    if [ "$RPG_UI" = "basic" ]; then
        basic_text "$title" "$text"
        return
    fi

    rpg_ui_size
    tmp=$(mktemp "${TMPDIR:-/tmp}/rpg-ui.XXXXXX") || return 1
    printf '%s\n' "$text" > "$tmp"
    NEWT_COLORS="$RPG_NEWT_THEME" "$RPG_UI" \
        --title "$title" --backtitle "$(rpg_backtitle)" \
        --ok-button "$L_BTN_CLOSE" --textbox "$tmp" "$UI_H" "$UI_W"
    rc=$?
    rm -f "$tmp"
    return $rc
}

#_____________________________________________________________________________________________
# Couche d'affichage : menu texte simple (fallback)
# Tout l'affichage part sur stderr pour que la valeur choisie reste sur stdout.

# Souris en mode texte (protocole X10 + SGR)
rpg_mouse_on() {
    [ "$RPG_UI" = "basic" ] || return 0
    [ -z "${RPG_NO_MOUSE-}" ] || return 0
    [ -t 2 ] || return 0
    printf '\033[?1000h\033[?1006h' >&2
}

rpg_mouse_off() {
    [ "$RPG_UI" = "basic" ] || return 0
    [ -t 2 ] || return 0
    printf '\033[?1000l\033[?1006l' >&2
}

# Barre de titre : "ResPinGuy" a gauche, page au centre-gauche, version a droite.
rpg_basic_header() {
    local title="$1"
    local tcol="${2-$C_YELLOW}"
    local cols pad
    cols=$(rpg_term_cols)
    pad=$((cols - ${#RPG_BACKTITLE} - ${#title} - ${#RPG_VERSION} - 7))
    [ "$pad" -lt 1 ] && pad=1
    printf '%s%s %s%s - %s%s%*s%s%s%s\n' \
        "$C_BOLD" "$C_YELLOW" "$RPG_BACKTITLE" "$C_BLUE" "$tcol" "$title" \
        "$pad" "" "$C_YELLOW" "$RPG_VERSION" "$C_RESET"
}

# Cadre bleu : ligne de separation
rpg_basic_rule() {
    local cols n line
    cols=$(rpg_term_cols)
    n=$((cols - 2))
    [ "$n" -lt 10 ] && n=10
    line=$(printf '%*s' "$n" "" | tr ' ' '-')
    printf '%s%s%s\n' "$C_BLUE" "$line" "$C_RESET"
}

# Tronque chaque ligne d'un bloc de texte a la largeur donnee
rpg_fit_block() {
    local text="$1"
    local cols="$2"
    local line out=""
    while IFS= read -r line; do
        [ "${#line}" -gt "$cols" ] && line="${line:0:cols}"
        out+="$line"
        out+=$'\n'
    done <<< "$text"
    printf '%s' "${out%$'\n'}"
}

basic_menu() {
    local title="$1"
    local prompt="$2"
    shift 2
    local -a tags=()
    local -a labels=()
    local i rc lastsize cancel ch buf seq body cb cx cy row prompt_lines cols lbl
    while [ $# -ge 2 ]; do
        tags+=("$1")
        labels+=("$2")
        shift 2
    done

    cancel="$L_BTN_BACK"
    [ "${UI_CANCEL_KEY-}" = "quit" ] && cancel="$L_BTN_QUIT"

    # Lignes du prompt : necessaire pour mapper les clics sur les entrees
    local _nl="${prompt//$'\n'/}"
    prompt_lines=$(( ${#prompt} - ${#_nl} + 1 ))
    cols=$(rpg_term_cols)

    lastsize=$(rpg_term_size_str)
    rpg_mouse_on

    while :; do
        {
            clear
            printf '%s%s' "$C_BLACK_BG" "$C_YELLOW"
            rpg_basic_header "$title"
            rpg_basic_rule
            printf '%s%s\n\n' "$C_YELLOW" "$(rpg_fit_block "$prompt" $((cols - 1)))"
            for ((i = 0; i < ${#tags[@]}; i++)); do
                lbl="${labels[$i]}"
                [ "${#lbl}" -gt $((cols - 8)) ] && lbl="${lbl:0:$((cols - 8))}"
                printf '  %s%2d)%s %s\n' "$C_YELLOW" "$((i + 1))" "$C_YELLOW" "$lbl"
            done
            printf '\n   %sq)%s %s\n\n' "$C_YELLOW" "$C_YELLOW" "$cancel"
            printf '%s%s%s ' "$C_YELLOW" "$L_PROMPT_CHOICE" "$C_RESET"
        } >&2

        buf=""
        while :; do
            IFS= read -rsn1 -t 0.25 ch
            rc=$?
            if [ $rc -eq 130 ]; then
                printf '\n' >&2
                rpg_mouse_off
                return 1
            fi
            if [ $rc -gt 128 ]; then
                if [ "$(rpg_term_size_str)" != "$lastsize" ]; then
                    lastsize=$(rpg_term_size_str)
                    continue 2
                fi
                continue
            elif [ $rc -ne 0 ]; then
                rpg_mouse_off
                return 1
            fi

            case "$ch" in
                q|Q)
                    printf '\n' >&2
                    rpg_mouse_off
                    return 1 ;;
                ''|$'\n'|$'\r')
                    printf '\n' >&2
                    if [ -n "$buf" ] && [[ "$buf" =~ ^[0-9]+$ ]] \
                       && [ "$buf" -ge 1 ] && [ "$buf" -le ${#tags[@]} ]; then
                        rpg_mouse_off
                        printf '%s' "${tags[$((buf - 1))]}"
                        return 0
                    fi
                    buf="" ;;
                $'\177'|$'\b')
                    if [ -n "$buf" ]; then
                        buf="${buf%?}"
                        printf '\b \b' >&2
                    fi ;;
                $'\033')
                    seq=""
                    while IFS= read -rsn1 -t 0.05 ch; do
                        seq+="$ch"
                        case "$seq" in
                            \[*[Mm]) break ;;
                        esac
                    done
                    if [ -z "$seq" ]; then
                        rpg_mouse_off
                        return 1
                    fi
                    # Souris SGR : ESC [ < bouton ; x ; y M
                    case "$seq" in
                        \[\<*M)
                            body="${seq#\[<}"
                            body="${body%M}"
                            cb="${body%%;*}"
                            cx="${body#*;}"
                            cy="${cx#*;}"
                            cx="${cx%%;*}"
                            if [[ "$cb" =~ ^[0-9]+$ ]] && [ "$cb" -lt 64 ] \
                               && [ $((cb & 3)) -eq 0 ] && [[ "$cy" =~ ^[0-9]+$ ]]; then
                                row=$(( cy - 4 - prompt_lines ))
                                if [ "$row" -ge 0 ] && [ "$row" -lt ${#tags[@]} ]; then
                                    rpg_mouse_off
                                    printf '%s' "${tags[$row]}"
                                    return 0
                                fi
                                if [ "$cy" -eq $(( 5 + prompt_lines + ${#tags[@]} )) ]; then
                                    rpg_mouse_off
                                    return 1
                                fi
                            fi ;;
                    esac ;;
                [[:digit:]])
                    buf+="$ch"
                    printf '%s' "$ch" >&2 ;;
                *)
                    : ;;
            esac
        done
    done
}

basic_input() {
    local title="$1"
    local prompt="$2"
    local def="${3-}"
    local v
    {
        clear
        printf '%s%s' "$C_BLACK_BG" "$C_YELLOW"
        rpg_basic_header "$title"
        rpg_basic_rule
        printf '%s%s\n' "$C_YELLOW" "$prompt"
        [ -n "$def" ] && printf '%s%s%s %s\n' "$C_YELLOW" "$L_INPUT_CURRENT" "$C_YELLOW" "$def"
        printf '%s\n%s\n' "$C_YELLOW" "$L_INPUT_HINT"
        printf '%s> %s' "$C_YELLOW" "$C_RESET"
    } >&2
    read -r v || return 1
    if [ -z "$v" ]; then
        v="$def"
    elif [ "$v" = "-" ]; then
        v=""
    fi
    printf '%s' "$v"
}

basic_yesno() {
    local title="$1"
    local text="$2"
    local kind="${3-}"
    local r tcol
    tcol="$C_YELLOW"
    [ "$kind" = "danger" ] && tcol="$C_YELLOW"
    {
        clear
        printf '%s%s' "$C_BLACK_BG" "$C_YELLOW"
        rpg_basic_header "$title" "$tcol"
        rpg_basic_rule
        printf '%s%s\n\n' "$C_YELLOW" "$text"
        printf '%s[o/N]%s ' "$C_YELLOW" "$C_RESET"
    } >&2
    read -r r || return 1
    case "$r" in
        o|O|y|Y|s|S|oui|Oui|OUI|yes|Yes|YES|si|Si|SI|sí|Sí|sim|Sim) return 0 ;;
        *) return 1 ;;
    esac
}

basic_msg() {
    local title="$1"
    local text="$2"
    local kind="${3-}"
    local tcol
    tcol="$C_YELLOW"
    [ "$kind" = "error" ] && tcol="$C_YELLOW"
    {
        clear
        printf '%s%s' "$C_BLACK_BG" "$C_YELLOW"
        rpg_basic_header "$title" "$tcol"
        rpg_basic_rule
        printf '%s%s\n\n' "$C_YELLOW" "$text"
        printf '%s%s%s' "$C_YELLOW" "$L_PRESS_ENTER" "$C_RESET"
    } >&2
    read -r _ || true
}

basic_text() {
    local title="$1"
    local text="$2"
    {
        clear
        printf '%s%s' "$C_BLACK_BG" "$C_YELLOW"
        rpg_basic_header "$title" "$C_YELLOW"
        rpg_basic_rule
        printf '%s%s\n\n' "$C_YELLOW" "$text"
        printf '%s%s%s' "$C_YELLOW" "$L_PRESS_ENTER" "$C_RESET"
    } >&2
    read -r _ || true
}

#_____________________________________________________________________________________________
# Lecture de la configuration

rpg_load_effective() {
    local -a c=()
    mapfile -t c < <(
        set +e
        . "$RPG_CONF" >/dev/null 2>&1
        printf '%s\n' \
            "${RPGBUILDNAME-}" \
            "${RPGHOME-}" \
            "${KERNEL-}" \
            "${ARCH-}" \
            "${VMLINUZ-}" \
            "${RPGCONFIGUSER-}" \
            "${RPGCONFIGUSERPERS-}" \
            "${HOME-}" \
            "${ROOTDIR-}"
    )

    CFG_NAME="${c[0]-}"
    CFG_OUT="${c[1]-}"
    CFG_KERNEL="${c[2]-}"
    CFG_ARCH="${c[3]-}"
    CFG_VMLINUZ="${c[4]-}"
    CFG_HOME="${c[7]-}"
    CFG_ROOTDIR="${c[8]-}"

    if [ -n "${c[6]-}" ]; then
        CFG_MODE="pers"
    elif [ -n "${c[5]-}" ]; then
        CFG_MODE="iso"
    else
        CFG_MODE="none"
    fi

    # Sans mode home, $HOME est celui du root courant : on ne l'affiche pas.
    if [ "$CFG_MODE" = "none" ]; then
        CFG_HOME=""
    fi

    CFG_KVER_FORCED=0
    CFG_KVML_FORCED=0
    CFG_ROOTDIR_SET=0
    if [ -f "$RPG_LOCAL" ]; then
        grep -q '^KERNEL=' "$RPG_LOCAL" 2>/dev/null && CFG_KVER_FORCED=1
        grep -q '^VMLINUZ=' "$RPG_LOCAL" 2>/dev/null && CFG_KVML_FORCED=1
        grep -q '^ROOTDIR=' "$RPG_LOCAL" 2>/dev/null && CFG_ROOTDIR_SET=1
    fi
}

# Echec de la lecture : retourne 1 si la configuration n'a pas pu etre chargee
# (kernel introuvable par exemple).
rpg_conf_ok() {
    [ -n "$CFG_NAME" ] && [ -n "$CFG_OUT" ] && [ -n "$CFG_VMLINUZ" ]
}

#_____________________________________________________________________________________________
# Ecriture de respinguy-config.local

rpg_shq() {
    printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

rpg_save_local() {
    local tmp="$RPG_LOCAL.tmp"
    {
        echo "# ResPinGuy - reglages de l'interface"
        echo "# Genere automatiquement le $(date '+%d/%m/%Y %H:%M')"
        echo "# Ce fichier est prioritaire sur respinguy-config."
        echo "# Le supprimer (menu Configuration > Reinitialiser) retablit les defauts."
        echo
        [ -n "$CFG_NAME" ] && echo "RPGBUILDNAME=$(rpg_shq "$CFG_NAME")"
        [ -n "$CFG_OUT" ] && echo "RPGHOME=$(rpg_shq "$CFG_OUT")"
        echo "RPG_LANG=$(rpg_shq "$RPG_LANG")"
        case "$CFG_MODE" in
            iso) echo "RPGCONFIGUSER=1" ;;
            pers) echo "RPGCONFIGUSERPERS=1" ;;
        esac
        if [ "$CFG_MODE" != "none" ] && [ -n "$CFG_HOME" ]; then
            echo "HOME=$(rpg_shq "$CFG_HOME")"
        fi
        if [ "$CFG_KVER_FORCED" -eq 1 ] && [ -n "$CFG_KERNEL" ]; then
            echo "KERNEL=$(rpg_shq "$CFG_KERNEL")"
        fi
        if [ "$CFG_KVML_FORCED" -eq 1 ] && [ -n "$CFG_VMLINUZ" ]; then
            echo "VMLINUZ=$(rpg_shq "$CFG_VMLINUZ")"
        fi
        if [ "$CFG_ROOTDIR_SET" -eq 1 ] && [ -n "$CFG_ROOTDIR" ]; then
            echo "ROOTDIR=$(rpg_shq "$CFG_ROOTDIR")"
        fi
        true
    } > "$tmp" || {
        rm -f "$tmp"
        return 1
    }
    if ! bash -n "$tmp" 2>/dev/null; then
        rm -f "$tmp"
        return 1
    fi
    mv -f "$tmp" "$RPG_LOCAL"
}

rpg_reset_local() {
    rm -f "$RPG_LOCAL"
}

# Met a jour uniquement la langue, sans toucher aux autres reglages
rpg_set_lang_local() {
    local tmp="$RPG_LOCAL.tmp"
    if [ -f "$RPG_LOCAL" ]; then
        grep -v '^RPG_LANG=' "$RPG_LOCAL" > "$tmp" 2>/dev/null
    else
        : > "$tmp"
    fi
    printf "RPG_LANG=%s\n" "$(rpg_shq "$RPG_LANG")" >> "$tmp"
    mv -f "$tmp" "$RPG_LOCAL"
}

#_____________________________________________________________________________________________
# Validation des valeurs

rpg_check_name() {
    local n="$1"
    [ -n "$n" ] || return 1
    case "$n" in
        */*|*\\*) return 1 ;;
    esac
    return 0
}

# Le build fait "rm -rf $RPGHOME" : on interdit les dossiers systeme.
rpg_check_outdir() {
    local d="$1"
    [ -n "$d" ] || return 1
    case "$d" in
        /*) ;;
        *) return 1 ;;
    esac
    case "/$d/" in
        */../*) return 1 ;;
    esac
    case "$d" in
        /|/bin|/boot|/dev|/etc|/home|/lib|/lib64|/opt|/proc|/root|/run|/sbin|/srv|/sys|/tmp|/usr|/var|/mnt|/media)
            return 1 ;;
        /bin/*|/boot/*|/dev/*|/etc/*|/lib/*|/lib64/*|/proc/*|/run/*|/sbin/*|/sys/*|/usr/*)
            return 1 ;;
    esac
    return 0
}

rpg_derive_kver() {
    local base
    base=$(basename "$1")
    case "$base" in
        vmlinuz-*) printf '%s' "${base#vmlinuz-}" ;;
        kernel-*)  printf '%s' "${base#kernel-}" ;;
        vmlinuz)   printf '%s' "$(uname -r)" ;;
    esac
}

rpg_mode_label() {
    case "$CFG_MODE" in
        iso)  printf '%s' "$L_HOME_ISO" ;;
        pers) printf '%s' "$L_HOME_PERS" ;;
        *)    printf '%s' "$L_HOME_NONE" ;;
    esac
}

rpg_deps_label() {
    case "$DEPS_STATE" in
        OK) printf '%s' "$L_DEPS_OK" ;;
        KO) printf '%s' "$L_DEPS_KO" ;;
        *)  printf '%s' "$L_DEPS_UNKNOWN" ;;
    esac
}

rpg_kv() {
    printf '%-9s: %s\n' "$1" "$2"
}

#_____________________________________________________________________________________________
# Compatibilite : une ancienne configuration ne charge pas respinguy-config.local

rpg_ensure_compat() {
    [ -f "$RPG_CONF" ] || return 0
    grep -q 'respinguy-config.local' "$RPG_CONF" 2>/dev/null && return 0

    if ui_yesno "$L_COMPAT_T" "$L_COMPAT_B"; then
        {
            printf '\n# --- Reglages enregistres par l interface ResPinGuy ---\n'
            printf '[ -f "%s" ] && . "%s"\n' "$RPG_LOCAL" "$RPG_LOCAL"
        } >> "$RPG_CONF"
        ui_msg "$L_CFG_TITLE" "$L_COMPAT_DONE"
    else
        ui_msg "$L_CFG_TITLE" "$L_COMPAT_SKIP"
    fi
}

#_____________________________________________________________________________________________
# Etat affiche dans les menus

rpg_status_main() {
    local d
    d="${DISTRO_NAME:-$L_ST_UNKNOWN}"
    rpg_kv "$L_ST_SYSTEM" "${d:0:60}"
    rpg_kv "$L_ST_KERNEL" "$(printf '%s (%s)' "${CFG_KERNEL:-$L_ST_UNKNOWN}" "${CFG_ARCH:-?}")"
    rpg_kv "$L_ST_DEPS" "$(rpg_deps_label)"
    rpg_kv "$L_ST_ISO" "${CFG_NAME:-?}"
    rpg_kv "$L_ST_OUTPUT" "${CFG_OUT:-?}"
    rpg_kv "$L_ST_HOME" "$(rpg_mode_label)"
    rpg_kv "$L_ST_LANG" "$L_LANG_NAME"
    printf '\n%s' "$L_MENU_PROMPT"
}

rpg_status_config() {
    local k
    if [ "$CFG_KVER_FORCED" -eq 1 ] || [ "$CFG_KVML_FORCED" -eq 1 ]; then
        k=$(printf "$L_CFG_KERNEL_FORCED" "${CFG_KERNEL:-?}" "${CFG_VMLINUZ:-?}")
    else
        k=$(printf "$L_CFG_KERNEL_AUTO" "${CFG_KERNEL:-?}")
    fi
    rpg_kv "$L_CFG_NAME" "${CFG_NAME:-?}"
    rpg_kv "$L_CFG_OUT" "${CFG_OUT:-?}"
    rpg_kv "$L_CFG_HOME" "$(rpg_mode_label)"
    rpg_kv "$L_CFG_KERNEL" "$k"
    rpg_kv "$L_CFG_DIRS" "${CFG_ROOTDIR:-?}"
    printf '\n%s' "$L_CFG_PROMPT"
}

#_____________________________________________________________________________________________
# Verification des dependances

rpg_deps_state() {
    if bash "$RPG_FILE_DIR/respinguy-app-dep" >/dev/null 2>&1; then
        DEPS_STATE="OK"
    else
        DEPS_STATE="KO"
    fi
}

# Sommes-nous dans le live ResPinGuy ?
rpg_is_live() {
    grep -qE '(^| )root=live:|(^| )rd\.live\.image' /proc/cmdline 2>/dev/null && return 0
    [ -f /run/initramfs/live/LiveOS/squashfs.img ] && return 0
    return 1
}

#_____________________________________________________________________________________________
# Action : creer l'image ISO

action_build() {
    local summary rc
    rpg_load_effective
    rpg_deps_state
    if ! rpg_conf_ok; then
        ui_error "$L_BUILD_ERR_T" "$L_BUILD_ERR_B"
        return
    fi

    if [ "$DEPS_STATE" != "OK" ]; then
        ui_yesno "$L_BUILD_DEPS_T" "$L_BUILD_DEPS_B" || return
    fi

    summary=$(printf "$L_BUILD_SUMMARY_B" \
        "$CFG_NAME" "$CFG_VMLINUZ" "$CFG_KERNEL" "$CFG_ARCH" "$CFG_ROOTDIR" \
        "$(rpg_mode_label)" "$CFG_OUT/$CFG_NAME-$CFG_ARCH.iso")

    ui_yesno "$L_BUILD_SUMMARY_T" "$summary" || return

    clear
    bash "$RPG_FILE_DIR/respinguy-build"
    rc=$?
    if [ $rc -eq 0 ]; then
        ui_msg "$L_BUILD_DONE_T" "$(printf "$L_BUILD_DONE_B" "$CFG_OUT/$CFG_NAME-$CFG_ARCH.iso")"
    else
        ui_error "$L_BUILD_FAIL_T" "$(printf "$L_BUILD_FAIL_B" "$rc")"
    fi
}

#_____________________________________________________________________________________________
# Action : configuration

config_home() {
    local choice v
    while :; do
        rpg_load_effective
        choice=$(ui_menu "$L_HOME_TITLE" "$(rpg_status_config)" \
            none "$L_HOME_ITEM_NONE" \
            iso  "$L_HOME_ITEM_ISO" \
            pers "$L_HOME_ITEM_PERS" \
            path "$L_HOME_ITEM_PATH" \
            back "$L_BTN_BACK") || return
        case "$choice" in
            none)
                CFG_MODE="none"
                CFG_HOME=""
                rpg_save_local && ui_msg "$L_CFG_ITEM_HOME" "$L_HOME_NONE_SAVED" ;;
            iso|pers)
                if [ -z "$CFG_HOME" ] || [ ! -d "$CFG_HOME" ]; then
                    v=$(ui_input "$L_HOME_TITLE" "$L_HOME_PATH_PROMPT" "$CFG_HOME") || continue
                    if [ ! -d "$v" ]; then
                        ui_error "$L_HOME_NOT_FOUND_T" "$(printf "$L_HOME_NOT_FOUND_B" "$v")"
                        continue
                    fi
                    CFG_HOME="$v"
                fi
                CFG_MODE="$choice"
                if [ "$choice" = "iso" ]; then
                    rpg_save_local && ui_msg "$L_CFG_ITEM_HOME" "$L_HOME_ISO_SAVED"
                else
                    rpg_save_local && ui_msg "$L_CFG_ITEM_HOME" "$L_HOME_PERS_SAVED"
                fi ;;
            path)
                v=$(ui_input "$L_HOME_TITLE" "$L_HOME_PATH_PROMPT" "$CFG_HOME") || continue
                if [ -z "$v" ]; then
                    continue
                fi
                if [ ! -d "$v" ]; then
                    ui_error "$L_HOME_NOT_FOUND_T" "$(printf "$L_HOME_NOT_FOUND_B" "$v")"
                    continue
                fi
                CFG_HOME="$v"
                if [ "$CFG_MODE" = "none" ]; then
                    rpg_save_local && ui_msg "$L_CFG_ITEM_HOME" "$(printf "$L_HOME_PATH_NOMODE" "$CFG_HOME")"
                else
                    rpg_save_local && ui_msg "$L_CFG_ITEM_HOME" "$(printf "$L_HOME_PATH_SAVED" "$CFG_HOME")"
                fi ;;
            *) return ;;
        esac
    done
}

config_kernel() {
    local choice v d
    while :; do
        rpg_load_effective
        choice=$(ui_menu "$L_KERNEL_TITLE" "$(rpg_status_config)" \
            ver  "$L_KERNEL_ITEM_VER" \
            path "$L_KERNEL_ITEM_PATH" \
            auto "$L_KERNEL_ITEM_AUTO" \
            back "$L_BTN_BACK") || return
        case "$choice" in
            ver)
                v=$(ui_input "$L_KERNEL_VER_TITLE" "$L_KERNEL_VER_PROMPT" "$CFG_KERNEL") || continue
                CFG_KERNEL="$v"
                if [ -z "$v" ]; then
                    CFG_KVER_FORCED=0
                    rpg_save_local && ui_msg "$L_CFG_ITEM_KERNEL" "$L_KERNEL_VER_EMPTY"
                else
                    CFG_KVER_FORCED=1
                    rpg_save_local && ui_msg "$L_CFG_ITEM_KERNEL" "$(printf "$L_KERNEL_VER_SAVED" "$CFG_KERNEL")"
                fi ;;
            path)
                v=$(ui_input "$L_KERNEL_PATH_TITLE" "$L_KERNEL_PATH_PROMPT" "$CFG_VMLINUZ") || continue
                if [ ! -f "$v" ]; then
                    ui_error "$L_KERNEL_NOT_FOUND_T" "$(printf "$L_KERNEL_NOT_FOUND_B" "$v")"
                    continue
                fi
                CFG_VMLINUZ="$v"
                CFG_KVML_FORCED=1
                if [ "$CFG_KVER_FORCED" -eq 0 ] || [ -z "$CFG_KERNEL" ]; then
                    d=$(rpg_derive_kver "$v")
                    if [ -n "$d" ]; then
                        CFG_KERNEL="$d"
                        CFG_KVER_FORCED=1
                    fi
                fi
                rpg_save_local && ui_msg "$L_CFG_ITEM_KERNEL" "$(printf "$L_KERNEL_SAVED" "$CFG_VMLINUZ" "${CFG_KERNEL:-?}")" ;;
            auto)
                CFG_KERNEL=""
                CFG_VMLINUZ=""
                CFG_KVER_FORCED=0
                CFG_KVML_FORCED=0
                rpg_save_local && ui_msg "$L_CFG_ITEM_KERNEL" "$L_KERNEL_AUTO_DONE" ;;
            *) return ;;
        esac
    done
}

action_config() {
    local choice v
    UI_CANCEL_KEY="back"
    while :; do
        rpg_load_effective
        if ! rpg_conf_ok; then
            if ui_yesno "$L_LOAD_ERR_T" "$L_LOAD_ERR_B" danger; then
                clear
                nano "$RPG_CONF"
            fi
            return
        fi
        choice=$(ui_menu "$L_CFG_TITLE" "$(rpg_status_config)" \
            name    "$L_CFG_ITEM_NAME" \
            outdir  "$L_CFG_ITEM_OUT" \
            home    "$L_CFG_ITEM_HOME" \
            kernel  "$L_CFG_ITEM_KERNEL" \
            rootdir "$L_CFG_ITEM_ROOTDIR" \
            edit    "$L_CFG_ITEM_EDIT" \
            reset   "$L_CFG_ITEM_RESET" \
            back    "$L_BTN_BACK") || return

        case "$choice" in
            name)
                v=$(ui_input "$L_NAME_TITLE" "$L_NAME_PROMPT" "$CFG_NAME") || continue
                if ! rpg_check_name "$v"; then
                    ui_error "$L_NAME_INVALID_T" "$L_NAME_INVALID_B"
                    continue
                fi
                CFG_NAME="$v"
                rpg_save_local && ui_msg "$L_NAME_TITLE" "$(printf "$L_NAME_SAVED" "$CFG_NAME")" ;;
            outdir)
                v=$(ui_input "$L_OUT_TITLE" "$L_OUT_PROMPT" "$CFG_OUT") || continue
                if ! rpg_check_outdir "$v"; then
                    ui_error "$L_OUT_INVALID_T" "$(printf "$L_OUT_INVALID_B" "$v")"
                    continue
                fi
                mkdir -p "$v" 2>/dev/null
                CFG_OUT="$v"
                rpg_save_local && ui_msg "$L_OUT_TITLE" "$(printf "$L_OUT_SAVED" "$CFG_OUT")" ;;
            home)
                config_home ;;
            kernel)
                config_kernel ;;
            rootdir)
                v=$(ui_input "$L_ROOTDIR_TITLE" "$L_ROOTDIR_PROMPT" "$CFG_ROOTDIR") || continue
                if [ -z "$v" ]; then
                    ui_error "$L_ROOTDIR_TITLE" "$L_ROOTDIR_EMPTY"
                    continue
                fi
                CFG_ROOTDIR="$v"
                CFG_ROOTDIR_SET=1
                rpg_save_local && ui_msg "$L_ROOTDIR_TITLE" "$L_ROOTDIR_SAVED" ;;
            edit)
                if [ ! -f "$RPG_LOCAL" ]; then
                    rpg_save_local
                fi
                clear
                nano "$RPG_LOCAL"
                if bash -n "$RPG_LOCAL" 2>/tmp/rpg-local-err; then
                    ui_msg "$L_EDIT_TITLE" "$L_EDIT_OK"
                else
                    ui_text "$L_EDIT_ERR_T" "$(cat /tmp/rpg-local-err)"
                fi
                rm -f /tmp/rpg-local-err ;;
            reset)
                if ui_yesno "$L_RESET_TITLE" "$L_RESET_PROMPT" danger; then
                    rpg_reset_local
                    ui_msg "$L_RESET_TITLE" "$L_RESET_DONE"
                fi ;;
            *) return ;;
        esac
    done
}

#_____________________________________________________________________________________________
# Action : dependances

action_deps() {
    local out rc rc2 out2
    out=$(bash "$RPG_FILE_DIR/respinguy-app-dep" 2>&1)
    rc=$?
    ui_text "$L_DEPS_TITLE" "$out"

    if [ $rc -ne 0 ] || printf '%s' "$out" | grep -q 'OPTIONNEL'; then
        if ui_yesno "$L_DEPS_MISSING_T" "$L_DEPS_MISSING_B"; then
            clear
            bash "$RPG_FILE_DIR/respinguy-app-dep-force-install"
            rc2=$?
            out2=$(bash "$RPG_FILE_DIR/respinguy-app-dep" 2>&1)
            rpg_deps_state
            if [ $rc2 -eq 0 ] && [ "$DEPS_STATE" = "OK" ] \
               && ! printf '%s' "$out2" | grep -q 'OPTIONNEL'; then
                ui_msg "$L_DEPS_TITLE" "$L_DEPS_DONE"
            else
                ui_error "$L_DEPS_TITLE" "$L_DEPS_PARTIAL"
            fi
        fi
    fi
    rpg_deps_state
}

#_____________________________________________________________________________________________
# Action : mise a jour

action_update() {
    ui_yesno "$L_UPDATE_T" "$L_UPDATE_B" || return

    clear
    # exec : les fichiers de /usr/share/ResPinGuy-File sont remplaces pendant
    # la mise a jour. Le script courant ne doit plus etre lu ensuite.
    exec bash "$RPG_FILE_DIR/respinguy-app-up"
}

#_____________________________________________________________________________________________
# Action : suppression

action_remove() {
    ui_yesno "$L_REMOVE_T" "$L_REMOVE_B" danger || return
    ui_yesno "$L_REMOVE_C_T" "$L_REMOVE_C_B" danger || return

    clear
    # exec : app-rm supprime /usr/share/ResPinGuy-File, y compris ce script.
    exec bash "$RPG_FILE_DIR/respinguy-app-rm"
}

#_____________________________________________________________________________________________
# Action : aide

action_help() {
    ui_text "$L_HELP_TITLE" "$L_HELP_BODY"
}

#_____________________________________________________________________________________________
# Action : langue

action_language() {
    local choice
    UI_CANCEL_KEY="back"
    choice=$(ui_menu "$L_LANG_TITLE" "$L_LANG_PROMPT" \
        fr "Français" \
        en "English" \
        es "Español" \
        de "Deutsch" \
        pt "Português" \
        back "$L_BTN_BACK") || return
    case "$choice" in
        fr|en|es|de|pt)
            rpg_load_lang "$choice"
            rpg_set_lang_local
            ui_msg "$L_LANG_TITLE" "$L_LANG_SAVED" ;;
    esac
}

#_____________________________________________________________________________________________
# Action : installer sur le disque

action_install() {
    if ! rpg_is_live; then
        ui_error "$L_MENU_INSTALL" "$L_INSTALL_NOTLIVE"
        return
    fi
    ui_yesno "$L_MENU_INSTALL" "$L_INSTALL_WARN_B" danger || return
    clear
    exec bash "$RPG_FILE_DIR/respinguy-install"
}

#_____________________________________________________________________________________________
# Action : parametres et info

action_settings() {
    local choice
    UI_CANCEL_KEY="back"
    while :; do
        rpg_load_effective
        choice=$(ui_menu "$L_MENU_SETTINGS" "$L_SETTINGS_PROMPT" \
            deps   "$L_MENU_DEPS" \
            update "$L_MENU_UPDATE" \
            remove "$L_MENU_REMOVE" \
            lang   "$L_MENU_LANG" \
            help   "$L_MENU_HELP" \
            back   "$L_BTN_BACK") || return
        case "$choice" in
            deps)   action_deps ;;
            update) action_update ;;
            remove) action_remove ;;
            lang)   action_language ;;
            help)   action_help ;;
            *)      return ;;
        esac
    done
}

#_____________________________________________________________________________________________
# Menu principal

main_menu() {
    local choice
    local -a items
    while :; do
        UI_CANCEL_KEY="quit"
        rpg_load_effective
        items=(build "$L_MENU_BUILD" config "$L_MENU_CONFIG")
        rpg_is_live && items+=(install "$L_MENU_INSTALL")
        items+=(settings "$L_MENU_SETTINGS" quit "$L_MENU_QUIT")
        choice=$(ui_menu "$L_MENU_HOME" "$(rpg_status_main)" "${items[@]}") || break

        case "$choice" in
            build)    action_build ;;
            config)   action_config ;;
            install)  action_install ;;
            settings) action_settings ;;
            *)        break ;;
        esac
    done
    clear
    exit 0
}

#_____________________________________________________________________________________________
# Demarrage

if [ ! -f "$RPG_LANG_DIR/fr.lang" ]; then
    echo "ResPinGuy : fichiers de langue manquants dans $RPG_LANG_DIR" >&2
    exit 1
fi

rpg_load_lang "$(rpg_detect_lang)"
detect_ui

# Restaure la souris du terminal en quittant
trap 'rpg_mouse_off' EXIT
trap 'rpg_mouse_off; exit 130' INT TERM

if [ ! -f "$RPG_CONF" ]; then
    ui_error "$L_CONF_MISSING_T" "$(printf "$L_CONF_MISSING_B" "$RPG_CONF")"
    exit 1
fi

case "${1-}" in
    --help|-h)
        action_help
        exit 0 ;;
esac

# Refus de lancer l'interface si les dependances obligatoires manquent
if [ -z "${RPG_SKIP_DEPS-}" ]; then
    RPG_DEPS_OUT=$(bash "$RPG_FILE_DIR/respinguy-app-dep" 2>&1)
    if [ $? -ne 0 ]; then
        ui_text "$L_DEPS_TITLE" "$RPG_DEPS_OUT

$L_DEPS_BLOCK_MSG"
        exit 1
    fi
fi

rpg_ensure_compat
rpg_deps_state
rpg_load_effective

case "${1-}" in
    --build)  action_build ;;
    --config) action_config ;;
    --deps)   action_deps ;;
    --lang)   action_language ;;
    "") main_menu ;;
    *)
        echo "$L_USAGE"
        exit 2 ;;
esac
