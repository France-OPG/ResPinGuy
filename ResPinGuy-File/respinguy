#_____________________________________________________________________________________________
# Menu principal

main_menu() {
    local choice
    UI_CANCEL="Quitter"
    while :; do
        rpg_load_effective
        choice=$(ui_menu "Accueil" "$(rpg_status_main)" \
            build  "Creer l'image ISO" \
            config "Configuration" \
            deps   "Verifier les dependances" \
            update "Mettre a jour ResPinGuy" \
            remove "Supprimer ResPinGuy" \
            help   "Aide" \
            quit   "Quitter") || break

        case "$choice" in
            build)  action_build ;;
            config) action_config ;;
            deps)   action_deps ;;
            update) action_update ;;
            remove) action_remove ;;
            help)   action_help ;;
            *)      break ;;
        esac
    done
    clear
    exit 0
}

#_____________________________________________________________________________________________
# Demarrage

detect_ui

if [ ! -f "$RPG_CONF" ]; then
    ui_error "ResPinGuy" "Fichier de configuration absent :

$RPG_CONF

Reinstallez ResPinGuy."
    exit 1
fi

case "${1-}" in
    --help|-h)
        action_help
        exit 0 ;;
esac

rpg_ensure_compat
rpg_deps_state
rpg_load_effective

case "${1-}" in
    --build)  action_build ;;
    --config) action_config ;;
    --deps)   action_deps ;;
    "") main_menu ;;
    *)
        echo "Usage : respinguy [--build|--config|--deps|--help]"
        exit 2 ;;
esac
